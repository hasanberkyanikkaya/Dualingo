{
  "expo": {
    "name": "Dualingo",
    "slug": "dualingo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dualingo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.hasanberk.ogrenme"
    },
    "android": {
      "package": "com.hasanberk.ogrenme",
      "adaptiveIcon": {
        "backgroundColor": "#FFE1EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF5F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bulunduğun ilçeyi bulup namaz vakitlerini ona göre göstermek için konumun bir kez okunur. İstemezsen ilçeni listeden elle seçebilirsin."
        }
      ],
      "expo-notifications",
      "expo-sqlite",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/cd757927-032e-41ff-ad6a-8d3269d0d057",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {},
      "audioBaseUrl": "",
      "eas": {
        "projectId": "cd757927-032e-41ff-ad6a-8d3269d0d057"
      }
    },
    "owner": "hasanberk"
  }
}

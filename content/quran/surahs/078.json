{
  "schemaVersion": 1,
  "surah": {
    "id": 78,
    "nameArabic": "النبإ",
    "nameTurkish": "Nebe' Sûresi",
    "verseCount": 40,
    "firstGlobalOrder": 5673
  },
  "verses": [
    {
      "key": "78:1",
      "surahId": 78,
      "numberInSurah": 1,
      "globalOrder": 5673,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "عَمَّ يَتَسَآءَلُونَ",
      "translationText": "Birbirlerine neyi soruyorlar?",
      "translationFootnotes": []
    },
    {
      "key": "78:2",
      "surahId": 78,
      "numberInSurah": 2,
      "globalOrder": 5674,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ",
      "translationText": "O büyük haberden (kıyametten) mi?",
      "translationFootnotes": []
    },
    {
      "key": "78:3",
      "surahId": 78,
      "numberInSurah": 3,
      "globalOrder": 5675,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ",
      "translationText": "Ki onlar onda ayrılığa düşmektedirler.",
      "translationFootnotes": []
    },
    {
      "key": "78:4",
      "surahId": 78,
      "numberInSurah": 4,
      "globalOrder": 5676,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "كَلَّا سَيَعْلَمُونَ",
      "translationText": "Hayır, ilerde bilecekler.",
      "translationFootnotes": []
    },
    {
      "key": "78:5",
      "surahId": 78,
      "numberInSurah": 5,
      "globalOrder": 5677,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "ثُمَّ كَلَّا سَيَعْلَمُونَ",
      "translationText": "Hayır hayır, ilerde bilecekler.",
      "translationFootnotes": []
    },
    {
      "key": "78:6",
      "surahId": 78,
      "numberInSurah": 6,
      "globalOrder": 5678,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا",
      "translationText": "Biz yeryüzünü bir beşik yapmadık mı?",
      "translationFootnotes": []
    },
    {
      "key": "78:7",
      "surahId": 78,
      "numberInSurah": 7,
      "globalOrder": 5679,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "وَٱلْجِبَالَ أَوْتَادًا",
      "translationText": "Dağları da birer kazık kılmadık mı?",
      "translationFootnotes": []
    },
    {
      "key": "78:8",
      "surahId": 78,
      "numberInSurah": 8,
      "globalOrder": 5680,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "وَخَلَقْنَـٰكُمْ أَزْوَٰجًا",
      "translationText": "Sizleri çift çift yarattık.",
      "translationFootnotes": []
    },
    {
      "key": "78:9",
      "surahId": 78,
      "numberInSurah": 9,
      "globalOrder": 5681,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا",
      "translationText": "Uykunuzu bir dinlenme yaptık.",
      "translationFootnotes": []
    },
    {
      "key": "78:10",
      "surahId": 78,
      "numberInSurah": 10,
      "globalOrder": 5682,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا",
      "translationText": "Geceyi bir örtü yaptık.",
      "translationFootnotes": []
    },
    {
      "key": "78:11",
      "surahId": 78,
      "numberInSurah": 11,
      "globalOrder": 5683,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا",
      "translationText": "Gündüzü de bir geçim zamanı yaptık.",
      "translationFootnotes": []
    },
    {
      "key": "78:12",
      "surahId": 78,
      "numberInSurah": 12,
      "globalOrder": 5684,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا",
      "translationText": "Üstünüze yedi sağlam bina (gök) çattık.",
      "translationFootnotes": []
    },
    {
      "key": "78:13",
      "surahId": 78,
      "numberInSurah": 13,
      "globalOrder": 5685,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "وَجَعَلْنَا سِرَاجًا وَهَّاجًا",
      "translationText": "İçlerine ışık saçan bir kandil astık.",
      "translationFootnotes": []
    },
    {
      "key": "78:14",
      "surahId": 78,
      "numberInSurah": 14,
      "globalOrder": 5686,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا",
      "translationText": "Yoğunlaşmış bulutlardan şarıl şarıl bir su indirdik.",
      "translationFootnotes": []
    },
    {
      "key": "78:15",
      "surahId": 78,
      "numberInSurah": 15,
      "globalOrder": 5687,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا",
      "translationText": "Onunla taneler ve otlar çıkaralım diye.",
      "translationFootnotes": []
    },
    {
      "key": "78:16",
      "surahId": 78,
      "numberInSurah": 16,
      "globalOrder": 5688,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "وَجَنَّـٰتٍ أَلْفَافًا",
      "translationText": "Ve sarmaş dolaş bağlar bahçeler (çıkaralım diye).",
      "translationFootnotes": []
    },
    {
      "key": "78:17",
      "surahId": 78,
      "numberInSurah": 17,
      "globalOrder": 5689,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَـٰتًا",
      "translationText": "Kuşkusuz o hüküm günü kararlaştırılmış bir vakit olmuştur.",
      "translationFootnotes": []
    },
    {
      "key": "78:18",
      "surahId": 78,
      "numberInSurah": 18,
      "globalOrder": 5690,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا",
      "translationText": "O gün Sûr'a üflenir, bölük bölük gelirsiniz.",
      "translationFootnotes": []
    },
    {
      "key": "78:19",
      "surahId": 78,
      "numberInSurah": 19,
      "globalOrder": 5691,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا",
      "translationText": "Gök de açılmış, kapı kapı olmuştur.",
      "translationFootnotes": []
    },
    {
      "key": "78:20",
      "surahId": 78,
      "numberInSurah": 20,
      "globalOrder": 5692,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
      "translationText": "Dağlar yürütülmüş, serap olmuştur.",
      "translationFootnotes": []
    },
    {
      "key": "78:21",
      "surahId": 78,
      "numberInSurah": 21,
      "globalOrder": 5693,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا",
      "translationText": "Kuşkusuz Cehennem gözetleme yeri olmuştur.",
      "translationFootnotes": []
    },
    {
      "key": "78:22",
      "surahId": 78,
      "numberInSurah": 22,
      "globalOrder": 5694,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "لِّلطَّـٰغِينَ مَـَٔابًا",
      "translationText": "Azgınlar için son varılacak yer olmuştur.",
      "translationFootnotes": []
    },
    {
      "key": "78:23",
      "surahId": 78,
      "numberInSurah": 23,
      "globalOrder": 5695,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "لَّـٰبِثِينَ فِيهَآ أَحْقَابًا",
      "translationText": "Orada çağlarca kalacaklardır.",
      "translationFootnotes": []
    },
    {
      "key": "78:24",
      "surahId": 78,
      "numberInSurah": 24,
      "globalOrder": 5696,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا",
      "translationText": "Orada ne bir serinlik tadacaklar, ne de içecek bir şey.",
      "translationFootnotes": []
    },
    {
      "key": "78:25",
      "surahId": 78,
      "numberInSurah": 25,
      "globalOrder": 5697,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "إِلَّا حَمِيمًا وَغَسَّاقًا",
      "translationText": "Ancak bir kaynar su ve irin (içecekler).",
      "translationFootnotes": []
    },
    {
      "key": "78:26",
      "surahId": 78,
      "numberInSurah": 26,
      "globalOrder": 5698,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "جَزَآءً وِفَاقًا",
      "translationText": "Bir ceza ki tam yaptıklarına uygun.",
      "translationFootnotes": []
    },
    {
      "key": "78:27",
      "surahId": 78,
      "numberInSurah": 27,
      "globalOrder": 5699,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا",
      "translationText": "Çünkü onlar hiçbir hesap ummazlardı.",
      "translationFootnotes": []
    },
    {
      "key": "78:28",
      "surahId": 78,
      "numberInSurah": 28,
      "globalOrder": 5700,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا كِذَّابًا",
      "translationText": "Âyetlerimizi yalanlaya yalanlaya tam bir yalancı olmuşlardı.",
      "translationFootnotes": []
    },
    {
      "key": "78:29",
      "surahId": 78,
      "numberInSurah": 29,
      "globalOrder": 5701,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ كِتَـٰبًا",
      "translationText": "Biz ise herşeyi sayıp bir kitaba geçirmişiz.",
      "translationFootnotes": []
    },
    {
      "key": "78:30",
      "surahId": 78,
      "numberInSurah": 30,
      "globalOrder": 5702,
      "pageNumber": 582,
      "juzNumber": 30,
      "arabicText": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا",
      "translationText": "(Onlara): \"Şimdi tadın (cezanızı). Artık size azabınızı artırmaktan başka bir şey yapmayacağız\" (denir).",
      "translationFootnotes": []
    },
    {
      "key": "78:31",
      "surahId": 78,
      "numberInSurah": 31,
      "globalOrder": 5703,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "إِنَّ لِلْمُتَّقِينَ مَفَازًا",
      "translationText": "Kuşkusuz takva sahipleri için bir kurtuluş var.",
      "translationFootnotes": []
    },
    {
      "key": "78:32",
      "surahId": 78,
      "numberInSurah": 32,
      "globalOrder": 5704,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "حَدَآئِقَ وَأَعْنَـٰبًا",
      "translationText": "Bahçeler var, bağlar var.",
      "translationFootnotes": []
    },
    {
      "key": "78:33",
      "surahId": 78,
      "numberInSurah": 33,
      "globalOrder": 5705,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "وَكَوَاعِبَ أَتْرَابًا",
      "translationText": "Memeleri tomurcuklanmış yaşıt kızlar var.",
      "translationFootnotes": []
    },
    {
      "key": "78:34",
      "surahId": 78,
      "numberInSurah": 34,
      "globalOrder": 5706,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "وَكَأْسًا دِهَاقًا",
      "translationText": "Dopdolu kadehler var.",
      "translationFootnotes": []
    },
    {
      "key": "78:35",
      "surahId": 78,
      "numberInSurah": 35,
      "globalOrder": 5707,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا",
      "translationText": "Orada ne boş bir söz işitirler, ne de bir yalan.",
      "translationFootnotes": []
    },
    {
      "key": "78:36",
      "surahId": 78,
      "numberInSurah": 36,
      "globalOrder": 5708,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا",
      "translationText": "(Bunlar) Rabbinden yeterli bir bağış olarak (verilir).",
      "translationFootnotes": []
    },
    {
      "key": "78:37",
      "surahId": 78,
      "numberInSurah": 37,
      "globalOrder": 5709,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا",
      "translationText": "O, göklerin, yerin ve bu ikisi arasındakilerin Rabbidir. Rahmân'dır. Hiç kimse ondan bir hitaba mâlik olamaz.",
      "translationFootnotes": []
    },
    {
      "key": "78:38",
      "surahId": 78,
      "numberInSurah": 38,
      "globalOrder": 5710,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا",
      "translationText": "O gün Ruh ve melekler sıra sıra dururlar. Rahmân'ın izin verdikleri dışında hiç kimse konuşamaz. İzin verilen de doğruyu söyler.",
      "translationFootnotes": []
    },
    {
      "key": "78:39",
      "surahId": 78,
      "numberInSurah": 39,
      "globalOrder": 5711,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",
      "translationText": "İşte bu hak gündür. Artık dileyen Rabbine bir yol tutar.",
      "translationFootnotes": []
    },
    {
      "key": "78:40",
      "surahId": 78,
      "numberInSurah": 40,
      "globalOrder": 5712,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ تُرَٰبًۢا",
      "translationText": "Biz sizi yakın bir azap ile uyardık. O gün kişi ellerinin ne takdim ettiğine bakacak ve kâfir diyecek ki: \"Ah ne olaydı, ben bir toprak olaydım.\"",
      "translationFootnotes": []
    }
  ]
}

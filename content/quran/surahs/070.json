{
  "schemaVersion": 1,
  "surah": {
    "id": 70,
    "nameArabic": "المعارج",
    "nameTurkish": "Meâric Sûresi",
    "verseCount": 44,
    "firstGlobalOrder": 5376
  },
  "verses": [
    {
      "key": "70:1",
      "surahId": 70,
      "numberInSurah": 1,
      "globalOrder": 5376,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ",
      "translationText": "Bir isteyen, olacak azabı istedi.",
      "translationFootnotes": []
    },
    {
      "key": "70:2",
      "surahId": 70,
      "numberInSurah": 2,
      "globalOrder": 5377,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "لِّلْكَـٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ",
      "translationText": "Kâfirler için onu savacak yok.",
      "translationFootnotes": []
    },
    {
      "key": "70:3",
      "surahId": 70,
      "numberInSurah": 3,
      "globalOrder": 5378,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ",
      "translationText": "O, derece ve makamların sahibi Allah'tandır.",
      "translationFootnotes": []
    },
    {
      "key": "70:4",
      "surahId": 70,
      "numberInSurah": 4,
      "globalOrder": 5379,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "تَعْرُجُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ",
      "translationText": "Melekler ve Ruh miktarı ellibin yıl süren bir gün içinde ona çıkar.",
      "translationFootnotes": []
    },
    {
      "key": "70:5",
      "surahId": 70,
      "numberInSurah": 5,
      "globalOrder": 5380,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "فَٱصْبِرْ صَبْرًا جَمِيلًا",
      "translationText": "O halde güzel bir sabır ile sabret.",
      "translationFootnotes": []
    },
    {
      "key": "70:6",
      "surahId": 70,
      "numberInSurah": 6,
      "globalOrder": 5381,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا",
      "translationText": "Çünkü onlar onu uzak görürler.",
      "translationFootnotes": []
    },
    {
      "key": "70:7",
      "surahId": 70,
      "numberInSurah": 7,
      "globalOrder": 5382,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "وَنَرَىٰهُ قَرِيبًا",
      "translationText": "Biz ise onu yakın görüyoruz.",
      "translationFootnotes": []
    },
    {
      "key": "70:8",
      "surahId": 70,
      "numberInSurah": 8,
      "globalOrder": 5383,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ",
      "translationText": "O gün gök erimiş bir maden gibi olur.",
      "translationFootnotes": []
    },
    {
      "key": "70:9",
      "surahId": 70,
      "numberInSurah": 9,
      "globalOrder": 5384,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ",
      "translationText": "Dağlar da atılmış renkli yün gibi olur.",
      "translationFootnotes": []
    },
    {
      "key": "70:10",
      "surahId": 70,
      "numberInSurah": 10,
      "globalOrder": 5385,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا",
      "translationText": "Dost dostun halini soramaz.",
      "translationFootnotes": []
    },
    {
      "key": "70:11",
      "surahId": 70,
      "numberInSurah": 11,
      "globalOrder": 5386,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ",
      "translationText": "Birbirlerine gösterilirler. Suçlu o günün azabından kurtulmak için fidye vermek ister; oğullarını,",
      "translationFootnotes": []
    },
    {
      "key": "70:12",
      "surahId": 70,
      "numberInSurah": 12,
      "globalOrder": 5387,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "وَصَـٰحِبَتِهِۦ وَأَخِيهِ",
      "translationText": "Eşini ve kardeşini,",
      "translationFootnotes": []
    },
    {
      "key": "70:13",
      "surahId": 70,
      "numberInSurah": 13,
      "globalOrder": 5388,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ",
      "translationText": "Kendisini barındıran, içinde yetiştiği tüm ailesini,",
      "translationFootnotes": []
    },
    {
      "key": "70:14",
      "surahId": 70,
      "numberInSurah": 14,
      "globalOrder": 5389,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ",
      "translationText": "Ve yeryüzünde bulunanların hepsini ki, tek kendini kurtarabilsin.",
      "translationFootnotes": []
    },
    {
      "key": "70:15",
      "surahId": 70,
      "numberInSurah": 15,
      "globalOrder": 5390,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "كَلَّآ ۖ إِنَّهَا لَظَىٰ",
      "translationText": "Hayır, o alevlenen bir ateştir.",
      "translationFootnotes": []
    },
    {
      "key": "70:16",
      "surahId": 70,
      "numberInSurah": 16,
      "globalOrder": 5391,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "نَزَّاعَةً لِّلشَّوَىٰ",
      "translationText": "Derileri kavurur, soyar.",
      "translationFootnotes": []
    },
    {
      "key": "70:17",
      "surahId": 70,
      "numberInSurah": 17,
      "globalOrder": 5392,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ",
      "translationText": "Çağırır, sırtını dönüp gideni,",
      "translationFootnotes": []
    },
    {
      "key": "70:18",
      "surahId": 70,
      "numberInSurah": 18,
      "globalOrder": 5393,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "وَجَمَعَ فَأَوْعَىٰٓ",
      "translationText": "Mal toplayıp kasada yığanı,",
      "translationFootnotes": []
    },
    {
      "key": "70:19",
      "surahId": 70,
      "numberInSurah": 19,
      "globalOrder": 5394,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "إِنَّ ٱلْإِنسَـٰنَ خُلِقَ هَلُوعًا",
      "translationText": "Doğrusu insan dayanıksız ve huysuz yaratılmıştır.",
      "translationFootnotes": []
    },
    {
      "key": "70:20",
      "surahId": 70,
      "numberInSurah": 20,
      "globalOrder": 5395,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا",
      "translationText": "Kendisine kötülük dokundu mu sızlanır.",
      "translationFootnotes": []
    },
    {
      "key": "70:21",
      "surahId": 70,
      "numberInSurah": 21,
      "globalOrder": 5396,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا",
      "translationText": "Kendisine hayır dokundu mu cimrilik eder.",
      "translationFootnotes": []
    },
    {
      "key": "70:22",
      "surahId": 70,
      "numberInSurah": 22,
      "globalOrder": 5397,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "إِلَّا ٱلْمُصَلِّينَ",
      "translationText": "Ancak namaz kılanlar bunun dışındadır.",
      "translationFootnotes": []
    },
    {
      "key": "70:23",
      "surahId": 70,
      "numberInSurah": 23,
      "globalOrder": 5398,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ",
      "translationText": "Onlar ki namazlarını sürekli kılarlar.",
      "translationFootnotes": []
    },
    {
      "key": "70:24",
      "surahId": 70,
      "numberInSurah": 24,
      "globalOrder": 5399,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ",
      "translationText": "Onların mallarında belli bir hak vardır,",
      "translationFootnotes": []
    },
    {
      "key": "70:25",
      "surahId": 70,
      "numberInSurah": 25,
      "globalOrder": 5400,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ",
      "translationText": "Hem isteyen için, hem de istemekten utanan yoksul için.",
      "translationFootnotes": []
    },
    {
      "key": "70:26",
      "surahId": 70,
      "numberInSurah": 26,
      "globalOrder": 5401,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ",
      "translationText": "Onlar ki ceza gününü tasdik ederler.",
      "translationFootnotes": []
    },
    {
      "key": "70:27",
      "surahId": 70,
      "numberInSurah": 27,
      "globalOrder": 5402,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ",
      "translationText": "Rablerinin azabından korkarlar.",
      "translationFootnotes": []
    },
    {
      "key": "70:28",
      "surahId": 70,
      "numberInSurah": 28,
      "globalOrder": 5403,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ",
      "translationText": "Çünkü Rablerinin azabından emin olunmaz.",
      "translationFootnotes": []
    },
    {
      "key": "70:29",
      "surahId": 70,
      "numberInSurah": 29,
      "globalOrder": 5404,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَـٰفِظُونَ",
      "translationText": "Onlar ki ırzlarını korurlar.",
      "translationFootnotes": []
    },
    {
      "key": "70:30",
      "surahId": 70,
      "numberInSurah": 30,
      "globalOrder": 5405,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ",
      "translationText": "Ancak zevcelerine ve cariyelerine karşı hariç. Çünkü onlara yaklaştıklarında kınanmazlar.",
      "translationFootnotes": []
    },
    {
      "key": "70:31",
      "surahId": 70,
      "numberInSurah": 31,
      "globalOrder": 5406,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ",
      "translationText": "Bundan ötesini isteyenler, var ya işte onlar haddi aşanlardır.",
      "translationFootnotes": []
    },
    {
      "key": "70:32",
      "surahId": 70,
      "numberInSurah": 32,
      "globalOrder": 5407,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ",
      "translationText": "Onlar emanetlerini ve ahitlerini gözetirler.",
      "translationFootnotes": []
    },
    {
      "key": "70:33",
      "surahId": 70,
      "numberInSurah": 33,
      "globalOrder": 5408,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "وَٱلَّذِينَ هُم بِشَهَـٰدَٰتِهِمْ قَآئِمُونَ",
      "translationText": "Şahitliklerinde dürüsttürler.",
      "translationFootnotes": []
    },
    {
      "key": "70:34",
      "surahId": 70,
      "numberInSurah": 34,
      "globalOrder": 5409,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ",
      "translationText": "Namazlarına devam ederler.",
      "translationFootnotes": []
    },
    {
      "key": "70:35",
      "surahId": 70,
      "numberInSurah": 35,
      "globalOrder": 5410,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "أُو۟لَـٰٓئِكَ فِى جَنَّـٰتٍ مُّكْرَمُونَ",
      "translationText": "İşte bunlar cennetlerde ağırlanırlar.",
      "translationFootnotes": []
    },
    {
      "key": "70:36",
      "surahId": 70,
      "numberInSurah": 36,
      "globalOrder": 5411,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ",
      "translationText": "Şimdi ne oluyor o inkâr edenlere ki, sana doğru boyunlarını uzatarak koşuyorlar:",
      "translationFootnotes": []
    },
    {
      "key": "70:37",
      "surahId": 70,
      "numberInSurah": 37,
      "globalOrder": 5412,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ",
      "translationText": "Sağdan ve soldan bölük bölük.",
      "translationFootnotes": []
    },
    {
      "key": "70:38",
      "surahId": 70,
      "numberInSurah": 38,
      "globalOrder": 5413,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ",
      "translationText": "Onlardan herbiri, bir nimet cennetine sokulacağını mı umuyor?",
      "translationFootnotes": []
    },
    {
      "key": "70:39",
      "surahId": 70,
      "numberInSurah": 39,
      "globalOrder": 5414,
      "pageNumber": 569,
      "juzNumber": 29,
      "arabicText": "كَلَّآ ۖ إِنَّا خَلَقْنَـٰهُم مِّمَّا يَعْلَمُونَ",
      "translationText": "Hayır, biz onları bildikleri şeyden yarattık.",
      "translationFootnotes": []
    },
    {
      "key": "70:40",
      "surahId": 70,
      "numberInSurah": 40,
      "globalOrder": 5415,
      "pageNumber": 570,
      "juzNumber": 29,
      "arabicText": "فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَـٰرِقِ وَٱلْمَغَـٰرِبِ إِنَّا لَقَـٰدِرُونَ",
      "translationText": "Artık o doğuların ve batıların Rabbine yemine ne gerek, elbette bizim gücümüz yeter.",
      "translationFootnotes": []
    },
    {
      "key": "70:41",
      "surahId": 70,
      "numberInSurah": 41,
      "globalOrder": 5416,
      "pageNumber": 570,
      "juzNumber": 29,
      "arabicText": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ",
      "translationText": "Onları kendilerinden daha hayırlı olanlarla değiştirebiliriz ve bizim önümüze geçilmez.",
      "translationFootnotes": []
    },
    {
      "key": "70:42",
      "surahId": 70,
      "numberInSurah": 42,
      "globalOrder": 5417,
      "pageNumber": 570,
      "juzNumber": 29,
      "arabicText": "فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ",
      "translationText": "O halde bırak onları, kendilerine vaad edilen günlerine kavuşuncaya kadar dalıp oynayadursunlar.",
      "translationFootnotes": []
    },
    {
      "key": "70:43",
      "surahId": 70,
      "numberInSurah": 43,
      "globalOrder": 5418,
      "pageNumber": 570,
      "juzNumber": 29,
      "arabicText": "يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًا كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ",
      "translationText": "O gün kabirlerden hızlı hızlı çıkacaklar, sanki putlara gidiyorlarmış gibi fırlayacaklar.",
      "translationFootnotes": []
    },
    {
      "key": "70:44",
      "surahId": 70,
      "numberInSurah": 44,
      "globalOrder": 5419,
      "pageNumber": 570,
      "juzNumber": 29,
      "arabicText": "خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ",
      "translationText": "Gözleri düşük, kendilerini bir alçaklık saracak da saracak. İşte onlara vaad edilen gün, o gündür.",
      "translationFootnotes": []
    }
  ]
}

{
  "schemaVersion": 1,
  "surah": {
    "id": 55,
    "nameArabic": "الرحمن",
    "nameTurkish": "Rahmân Sûresi",
    "verseCount": 78,
    "firstGlobalOrder": 4902
  },
  "verses": [
    {
      "key": "55:1",
      "surahId": 55,
      "numberInSurah": 1,
      "globalOrder": 4902,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "ٱلرَّحْمَـٰنُ",
      "translationText": "Rahmân (çok merhametli olan Allah)",
      "translationFootnotes": []
    },
    {
      "key": "55:2",
      "surahId": 55,
      "numberInSurah": 2,
      "globalOrder": 4903,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "عَلَّمَ ٱلْقُرْءَانَ",
      "translationText": "Kurân'ı öğretti.",
      "translationFootnotes": []
    },
    {
      "key": "55:3",
      "surahId": 55,
      "numberInSurah": 3,
      "globalOrder": 4904,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "خَلَقَ ٱلْإِنسَـٰنَ",
      "translationText": "İnsanı yarattı.",
      "translationFootnotes": []
    },
    {
      "key": "55:4",
      "surahId": 55,
      "numberInSurah": 4,
      "globalOrder": 4905,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "عَلَّمَهُ ٱلْبَيَانَ",
      "translationText": "Ona beyanı öğretti.",
      "translationFootnotes": []
    },
    {
      "key": "55:5",
      "surahId": 55,
      "numberInSurah": 5,
      "globalOrder": 4906,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ",
      "translationText": "Güneş de ay da bir hesab iledir.",
      "translationFootnotes": []
    },
    {
      "key": "55:6",
      "surahId": 55,
      "numberInSurah": 6,
      "globalOrder": 4907,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ",
      "translationText": "Bitkiler ve ağaçlar secde etmektedirler.",
      "translationFootnotes": []
    },
    {
      "key": "55:7",
      "surahId": 55,
      "numberInSurah": 7,
      "globalOrder": 4908,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ",
      "translationText": "Göğü yükseltti ve mizanı koydu.",
      "translationFootnotes": []
    },
    {
      "key": "55:8",
      "surahId": 55,
      "numberInSurah": 8,
      "globalOrder": 4909,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ",
      "translationText": "Sakın tartıda taşkınlık etmeyin.",
      "translationFootnotes": []
    },
    {
      "key": "55:9",
      "surahId": 55,
      "numberInSurah": 9,
      "globalOrder": 4910,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ",
      "translationText": "Tartıyı adaletle yapın, terazide eksiklik yapmayın.",
      "translationFootnotes": []
    },
    {
      "key": "55:10",
      "surahId": 55,
      "numberInSurah": 10,
      "globalOrder": 4911,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ",
      "translationText": "(Allah) yeri mahlukat için (aşağıya) koydu.",
      "translationFootnotes": []
    },
    {
      "key": "55:11",
      "surahId": 55,
      "numberInSurah": 11,
      "globalOrder": 4912,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "فِيهَا فَـٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ",
      "translationText": "Orada meyvalar ve salkımlı hurma ağaçları vardır.",
      "translationFootnotes": []
    },
    {
      "key": "55:12",
      "surahId": 55,
      "numberInSurah": 12,
      "globalOrder": 4913,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ",
      "translationText": "Yapraklı taneler ve hoş kokulu bitkiler vardır.",
      "translationFootnotes": []
    },
    {
      "key": "55:13",
      "surahId": 55,
      "numberInSurah": 13,
      "globalOrder": 4914,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:14",
      "surahId": 55,
      "numberInSurah": 14,
      "globalOrder": 4915,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "خَلَقَ ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍ كَٱلْفَخَّارِ",
      "translationText": "Allah insanı, pişmiş bir çamura benzeyen bir balçıktan yarattı.",
      "translationFootnotes": []
    },
    {
      "key": "55:15",
      "surahId": 55,
      "numberInSurah": 15,
      "globalOrder": 4916,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ",
      "translationText": "Cinleri de hâlis ateşten yarattı.",
      "translationFootnotes": []
    },
    {
      "key": "55:16",
      "surahId": 55,
      "numberInSurah": 16,
      "globalOrder": 4917,
      "pageNumber": 531,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:17",
      "surahId": 55,
      "numberInSurah": 17,
      "globalOrder": 4918,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ",
      "translationText": "(O) iki doğunun ve iki batının Rabbidir.",
      "translationFootnotes": []
    },
    {
      "key": "55:18",
      "surahId": 55,
      "numberInSurah": 18,
      "globalOrder": 4919,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:19",
      "surahId": 55,
      "numberInSurah": 19,
      "globalOrder": 4920,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ",
      "translationText": "(Acı ve tatlı) iki denizi salıverdi birbirine kavuşuyorlar.",
      "translationFootnotes": []
    },
    {
      "key": "55:20",
      "surahId": 55,
      "numberInSurah": 20,
      "globalOrder": 4921,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "بَيْنَهُمَا بَرْزَخٌ لَّا يَبْغِيَانِ",
      "translationText": "Fakat aralarında bir engel vardır, birbirlerine geçip karışmıyorlar.",
      "translationFootnotes": []
    },
    {
      "key": "55:21",
      "surahId": 55,
      "numberInSurah": 21,
      "globalOrder": 4922,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:22",
      "surahId": 55,
      "numberInSurah": 22,
      "globalOrder": 4923,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ",
      "translationText": "İkisinden de inci ve mercan çıkar.",
      "translationFootnotes": []
    },
    {
      "key": "55:23",
      "surahId": 55,
      "numberInSurah": 23,
      "globalOrder": 4924,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:24",
      "surahId": 55,
      "numberInSurah": 24,
      "globalOrder": 4925,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَـٰمِ",
      "translationText": "Denizde koca dağlar gibi yükselen gemiler de onundur.",
      "translationFootnotes": []
    },
    {
      "key": "55:25",
      "surahId": 55,
      "numberInSurah": 25,
      "globalOrder": 4926,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:26",
      "surahId": 55,
      "numberInSurah": 26,
      "globalOrder": 4927,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "كُلُّ مَنْ عَلَيْهَا فَانٍ",
      "translationText": "Yer üzerinde bulunan her şey fânidir.",
      "translationFootnotes": []
    },
    {
      "key": "55:27",
      "surahId": 55,
      "numberInSurah": 27,
      "globalOrder": 4928,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ",
      "translationText": "Yalnız celâl ve ikram sahibi Rabbinin yüzü (zâtı) baki kalacaktır.",
      "translationFootnotes": []
    },
    {
      "key": "55:28",
      "surahId": 55,
      "numberInSurah": 28,
      "globalOrder": 4929,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:29",
      "surahId": 55,
      "numberInSurah": 29,
      "globalOrder": 4930,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ",
      "translationText": "Göklerde ve yerde bulunanlar, O'ndan isterler. O, her gün yeni bir iştedir.",
      "translationFootnotes": []
    },
    {
      "key": "55:30",
      "surahId": 55,
      "numberInSurah": 30,
      "globalOrder": 4931,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:31",
      "surahId": 55,
      "numberInSurah": 31,
      "globalOrder": 4932,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ",
      "translationText": "Ey insan ve cin! sizin de hesabınızı ele alacağız.",
      "translationFootnotes": []
    },
    {
      "key": "55:32",
      "surahId": 55,
      "numberInSurah": 32,
      "globalOrder": 4933,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:33",
      "surahId": 55,
      "numberInSurah": 33,
      "globalOrder": 4934,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "يَـٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَـٰنٍ",
      "translationText": "Ey cin ve insan toplulukları! Göklerin ve yerin çevresinden geçmeye gücünüz yeterse geçin gidin. Allah'ın verdiği bir güç olmadan geçemezsiniz.",
      "translationFootnotes": []
    },
    {
      "key": "55:34",
      "surahId": 55,
      "numberInSurah": 34,
      "globalOrder": 4935,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:35",
      "surahId": 55,
      "numberInSurah": 35,
      "globalOrder": 4936,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ",
      "translationText": "Üzerinize ateşten alev ve duman gönderilir, kendinizi savunamazsınız.",
      "translationFootnotes": []
    },
    {
      "key": "55:36",
      "surahId": 55,
      "numberInSurah": 36,
      "globalOrder": 4937,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz",
      "translationFootnotes": []
    },
    {
      "key": "55:37",
      "surahId": 55,
      "numberInSurah": 37,
      "globalOrder": 4938,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةً كَٱلدِّهَانِ",
      "translationText": "Gök yarılıp da, erimiş yağ gibi kıpkırmızı bir gül olduğu zaman...",
      "translationFootnotes": []
    },
    {
      "key": "55:38",
      "surahId": 55,
      "numberInSurah": 38,
      "globalOrder": 4939,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:39",
      "surahId": 55,
      "numberInSurah": 39,
      "globalOrder": 4940,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "فَيَوْمَئِذٍ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌ وَلَا جَآنٌّ",
      "translationText": "İşte o gün, ne insana ne de cinne günahından sorulmaz.",
      "translationFootnotes": []
    },
    {
      "key": "55:40",
      "surahId": 55,
      "numberInSurah": 40,
      "globalOrder": 4941,
      "pageNumber": 532,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:41",
      "surahId": 55,
      "numberInSurah": 41,
      "globalOrder": 4942,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَـٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ",
      "translationText": "Suçlular simalarından tanınır, alınlarından ve ayaklarından tutulur.",
      "translationFootnotes": []
    },
    {
      "key": "55:42",
      "surahId": 55,
      "numberInSurah": 42,
      "globalOrder": 4943,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:43",
      "surahId": 55,
      "numberInSurah": 43,
      "globalOrder": 4944,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "هَـٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ",
      "translationText": "İşte bu, suçluların yalanladığı cehennemdir.",
      "translationFootnotes": []
    },
    {
      "key": "55:44",
      "surahId": 55,
      "numberInSurah": 44,
      "globalOrder": 4945,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍ",
      "translationText": "Onunla kaynar su arasında dolaşırlar.",
      "translationFootnotes": []
    },
    {
      "key": "55:45",
      "surahId": 55,
      "numberInSurah": 45,
      "globalOrder": 4946,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:46",
      "surahId": 55,
      "numberInSurah": 46,
      "globalOrder": 4947,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ",
      "translationText": "Rabbinin makamından korkan kimselere iki cennet vardır.",
      "translationFootnotes": []
    },
    {
      "key": "55:47",
      "surahId": 55,
      "numberInSurah": 47,
      "globalOrder": 4948,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:48",
      "surahId": 55,
      "numberInSurah": 48,
      "globalOrder": 4949,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "ذَوَاتَآ أَفْنَانٍ",
      "translationText": "İkisinin de çeşitli ağaçları, meyvaları vardır.",
      "translationFootnotes": []
    },
    {
      "key": "55:49",
      "surahId": 55,
      "numberInSurah": 49,
      "globalOrder": 4950,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:50",
      "surahId": 55,
      "numberInSurah": 50,
      "globalOrder": 4951,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فِيهِمَا عَيْنَانِ تَجْرِيَانِ",
      "translationText": "İkisinde de akıp giden iki kaynak vardır.",
      "translationFootnotes": []
    },
    {
      "key": "55:51",
      "surahId": 55,
      "numberInSurah": 51,
      "globalOrder": 4952,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:52",
      "surahId": 55,
      "numberInSurah": 52,
      "globalOrder": 4953,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فِيهِمَا مِن كُلِّ فَـٰكِهَةٍ زَوْجَانِ",
      "translationText": "İkisinde de her türlü meyvadan çift çift vardır.",
      "translationFootnotes": []
    },
    {
      "key": "55:53",
      "surahId": 55,
      "numberInSurah": 53,
      "globalOrder": 4954,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:54",
      "surahId": 55,
      "numberInSurah": 54,
      "globalOrder": 4955,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍ ۚ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍ",
      "translationText": "Astarları atlastan yataklara yaslanırlar. İki cennetin de devşirmesi yakındır.",
      "translationFootnotes": []
    },
    {
      "key": "55:55",
      "surahId": 55,
      "numberInSurah": 55,
      "globalOrder": 4956,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:56",
      "surahId": 55,
      "numberInSurah": 56,
      "globalOrder": 4957,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فِيهِنَّ قَـٰصِرَٰتُ ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ",
      "translationText": "Oralarda gözlerini yalnız eşlerine çevirmiş dilberler var ki, bunlardan önce onlara ne insan ne de cin dokunmuştur.",
      "translationFootnotes": []
    },
    {
      "key": "55:57",
      "surahId": 55,
      "numberInSurah": 57,
      "globalOrder": 4958,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:58",
      "surahId": 55,
      "numberInSurah": 58,
      "globalOrder": 4959,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "كَأَنَّهُنَّ ٱلْيَاقُوتُ وَٱلْمَرْجَانُ",
      "translationText": "Sanki onlar yâkut ve mercandırlar.",
      "translationFootnotes": []
    },
    {
      "key": "55:59",
      "surahId": 55,
      "numberInSurah": 59,
      "globalOrder": 4960,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:60",
      "surahId": 55,
      "numberInSurah": 60,
      "globalOrder": 4961,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "هَلْ جَزَآءُ ٱلْإِحْسَـٰنِ إِلَّا ٱلْإِحْسَـٰنُ",
      "translationText": "İyiliğin karşılığı, yalnız iyilik değil midir?",
      "translationFootnotes": []
    },
    {
      "key": "55:61",
      "surahId": 55,
      "numberInSurah": 61,
      "globalOrder": 4962,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:62",
      "surahId": 55,
      "numberInSurah": 62,
      "globalOrder": 4963,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "وَمِن دُونِهِمَا جَنَّتَانِ",
      "translationText": "Bu ikisinden başka iki cennet daha vardır.",
      "translationFootnotes": []
    },
    {
      "key": "55:63",
      "surahId": 55,
      "numberInSurah": 63,
      "globalOrder": 4964,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:64",
      "surahId": 55,
      "numberInSurah": 64,
      "globalOrder": 4965,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "مُدْهَآمَّتَانِ",
      "translationText": "(Bu cennetler) yemyeşildirler.",
      "translationFootnotes": []
    },
    {
      "key": "55:65",
      "surahId": 55,
      "numberInSurah": 65,
      "globalOrder": 4966,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:66",
      "surahId": 55,
      "numberInSurah": 66,
      "globalOrder": 4967,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ",
      "translationText": "İkisinde de fışkıran iki kaynak vardır.",
      "translationFootnotes": []
    },
    {
      "key": "55:67",
      "surahId": 55,
      "numberInSurah": 67,
      "globalOrder": 4968,
      "pageNumber": 533,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:68",
      "surahId": 55,
      "numberInSurah": 68,
      "globalOrder": 4969,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "فِيهِمَا فَـٰكِهَةٌ وَنَخْلٌ وَرُمَّانٌ",
      "translationText": "İkisinde de her türlü meyva, hurma ve nar vardır.",
      "translationFootnotes": []
    },
    {
      "key": "55:69",
      "surahId": 55,
      "numberInSurah": 69,
      "globalOrder": 4970,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:70",
      "surahId": 55,
      "numberInSurah": 70,
      "globalOrder": 4971,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "فِيهِنَّ خَيْرَٰتٌ حِسَانٌ",
      "translationText": "İçlerinde güzel huylu, güzel yüzlü kadınlar vardır.",
      "translationFootnotes": []
    },
    {
      "key": "55:71",
      "surahId": 55,
      "numberInSurah": 71,
      "globalOrder": 4972,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:72",
      "surahId": 55,
      "numberInSurah": 72,
      "globalOrder": 4973,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "حُورٌ مَّقْصُورَٰتٌ فِى ٱلْخِيَامِ",
      "translationText": "Çadırlar içerisinde gözlerini yalnız kocalarına çevirmiş hûriler vardır.",
      "translationFootnotes": []
    },
    {
      "key": "55:73",
      "surahId": 55,
      "numberInSurah": 73,
      "globalOrder": 4974,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:74",
      "surahId": 55,
      "numberInSurah": 74,
      "globalOrder": 4975,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ",
      "translationText": "Bunlardan önce onlara ne insan ne de cin dokunmuştur.",
      "translationFootnotes": []
    },
    {
      "key": "55:75",
      "surahId": 55,
      "numberInSurah": 75,
      "globalOrder": 4976,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:76",
      "surahId": 55,
      "numberInSurah": 76,
      "globalOrder": 4977,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍ وَعَبْقَرِىٍّ حِسَانٍ",
      "translationText": "Yeşil yastıklara ve hârikulâde güzel işlemeli döşeklere yaslanırlar.",
      "translationFootnotes": []
    },
    {
      "key": "55:77",
      "surahId": 55,
      "numberInSurah": 77,
      "globalOrder": 4978,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "translationText": "Şimdi Rabbinizin hangi nimetlerini yalanlıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "55:78",
      "surahId": 55,
      "numberInSurah": 78,
      "globalOrder": 4979,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "تَبَـٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ",
      "translationText": "Büyüklük ve ikram sahibi Rabbinin adı ne yücedir!",
      "translationFootnotes": []
    }
  ]
}

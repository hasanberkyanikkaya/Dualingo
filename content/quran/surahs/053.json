{
  "schemaVersion": 1,
  "surah": {
    "id": 53,
    "nameArabic": "النجم",
    "nameTurkish": null,
    "verseCount": 62,
    "firstGlobalOrder": 4785
  },
  "verses": [
    {
      "key": "53:1",
      "surahId": 53,
      "numberInSurah": 1,
      "globalOrder": 4785,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "وَٱلنَّجْمِ إِذَا هَوَىٰ",
      "translationText": "İnmekte olan yıldıza andolsun ki,",
      "translationFootnotes": []
    },
    {
      "key": "53:2",
      "surahId": 53,
      "numberInSurah": 2,
      "globalOrder": 4786,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ",
      "translationText": "Arkadaşınız (Muhammed) sapmadı, azmadı.",
      "translationFootnotes": []
    },
    {
      "key": "53:3",
      "surahId": 53,
      "numberInSurah": 3,
      "globalOrder": 4787,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ",
      "translationText": "O, hevâdan (arzularına göre) konuşmaz.",
      "translationFootnotes": []
    },
    {
      "key": "53:4",
      "surahId": 53,
      "numberInSurah": 4,
      "globalOrder": 4788,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "إِنْ هُوَ إِلَّا وَحْىٌ يُوحَىٰ",
      "translationText": "O(nun konuşması kendisine ) vahyedilenden başkası değildir.",
      "translationFootnotes": []
    },
    {
      "key": "53:5",
      "surahId": 53,
      "numberInSurah": 5,
      "globalOrder": 4789,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ",
      "translationText": "Onu, müthiş kuvvetleri olan biri öğretti",
      "translationFootnotes": []
    },
    {
      "key": "53:6",
      "surahId": 53,
      "numberInSurah": 6,
      "globalOrder": 4790,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "ذُو مِرَّةٍ فَٱسْتَوَىٰ",
      "translationText": "(Ki o) akıl ve görüşünde kuvvetli (bir melek)dir. Hemen (gerçek meleklik şekliyle) doğruldu.",
      "translationFootnotes": []
    },
    {
      "key": "53:7",
      "surahId": 53,
      "numberInSurah": 7,
      "globalOrder": 4791,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ",
      "translationText": "O, en yüksek ufukta idi.",
      "translationFootnotes": []
    },
    {
      "key": "53:8",
      "surahId": 53,
      "numberInSurah": 8,
      "globalOrder": 4792,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "ثُمَّ دَنَا فَتَدَلَّىٰ",
      "translationText": "Sonra (Cebrail ona) yaklaştı ve (aşağıya doğru) sarktı.",
      "translationFootnotes": []
    },
    {
      "key": "53:9",
      "surahId": 53,
      "numberInSurah": 9,
      "globalOrder": 4793,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ",
      "translationText": "Onunla arasındaki mesafe, iki yay kadar, yahut daha az kaldı.",
      "translationFootnotes": []
    },
    {
      "key": "53:10",
      "surahId": 53,
      "numberInSurah": 10,
      "globalOrder": 4794,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ",
      "translationText": "(Allah), kuluna verdiği vahyi verdi.",
      "translationFootnotes": []
    },
    {
      "key": "53:11",
      "surahId": 53,
      "numberInSurah": 11,
      "globalOrder": 4795,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ",
      "translationText": "Onun gördüğünü kalb(i) yalanlamadı.",
      "translationFootnotes": []
    },
    {
      "key": "53:12",
      "surahId": 53,
      "numberInSurah": 12,
      "globalOrder": 4796,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "أَفَتُمَـٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ",
      "translationText": "Onun gördükleri hakkında şimdi kendisi ile tartışacak mısınız.",
      "translationFootnotes": []
    },
    {
      "key": "53:13",
      "surahId": 53,
      "numberInSurah": 13,
      "globalOrder": 4797,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ",
      "translationText": "Andolsun onu bir kez daha görmüştü.",
      "translationFootnotes": []
    },
    {
      "key": "53:14",
      "surahId": 53,
      "numberInSurah": 14,
      "globalOrder": 4798,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ",
      "translationText": "Sidretü'lMüntehâ'nın yanında.",
      "translationFootnotes": []
    },
    {
      "key": "53:15",
      "surahId": 53,
      "numberInSurah": 15,
      "globalOrder": 4799,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ",
      "translationText": "Ki Cennetü'lMe'vâ onun yanındadır.",
      "translationFootnotes": []
    },
    {
      "key": "53:16",
      "surahId": 53,
      "numberInSurah": 16,
      "globalOrder": 4800,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ",
      "translationText": "Sidre'yi kaplayan kaplıyordu.",
      "translationFootnotes": []
    },
    {
      "key": "53:17",
      "surahId": 53,
      "numberInSurah": 17,
      "globalOrder": 4801,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ",
      "translationText": "(Peygamberin) gözü şaşmadı ve sınırı aşmadı.",
      "translationFootnotes": []
    },
    {
      "key": "53:18",
      "surahId": 53,
      "numberInSurah": 18,
      "globalOrder": 4802,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "لَقَدْ رَأَىٰ مِنْ ءَايَـٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ",
      "translationText": "Andolsun ki o, Rabbinin âyetlerinden en büyüğünü gördü.",
      "translationFootnotes": []
    },
    {
      "key": "53:19",
      "surahId": 53,
      "numberInSurah": 19,
      "globalOrder": 4803,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "أَفَرَءَيْتُمُ ٱللَّـٰتَ وَٱلْعُزَّىٰ",
      "translationText": "Siz de gördünüz değil mi o Lât ve Uzza'yı?",
      "translationFootnotes": []
    },
    {
      "key": "53:20",
      "surahId": 53,
      "numberInSurah": 20,
      "globalOrder": 4804,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ",
      "translationText": "Ve üçüncü olarak da öteki (put) Menat'ı?",
      "translationFootnotes": []
    },
    {
      "key": "53:21",
      "surahId": 53,
      "numberInSurah": 21,
      "globalOrder": 4805,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ",
      "translationText": "Size erkek O'na dişi öyle mi?",
      "translationFootnotes": []
    },
    {
      "key": "53:22",
      "surahId": 53,
      "numberInSurah": 22,
      "globalOrder": 4806,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "تِلْكَ إِذًا قِسْمَةٌ ضِيزَىٰٓ",
      "translationText": "Öyle ise bu çok insafsızca bir taksim.",
      "translationFootnotes": []
    },
    {
      "key": "53:23",
      "surahId": 53,
      "numberInSurah": 23,
      "globalOrder": 4807,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَـٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ",
      "translationText": "Onlar hiçbir şey değil, sırf sizin ve babalarınızın taktığınız (boş) isimlerdir. Allah onlar hakkında hiçbir delil indirmedi. Onlar yalnız zanna ve nefislerin sevdasına uyuyorlar. Halbuki onlara Rableri tarafından yol gösterici gelmiştir.",
      "translationFootnotes": []
    },
    {
      "key": "53:24",
      "surahId": 53,
      "numberInSurah": 24,
      "globalOrder": 4808,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "أَمْ لِلْإِنسَـٰنِ مَا تَمَنَّىٰ",
      "translationText": "Yoksa her arzu ettiği şey, insanın kendisinin mi (olacak) dir?",
      "translationFootnotes": []
    },
    {
      "key": "53:25",
      "surahId": 53,
      "numberInSurah": 25,
      "globalOrder": 4809,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "فَلِلَّهِ ٱلْـَٔاخِرَةُ وَٱلْأُولَىٰ",
      "translationText": "Son da ilk de (ahiret de dünya da) Allah'ındır.",
      "translationFootnotes": []
    },
    {
      "key": "53:26",
      "surahId": 53,
      "numberInSurah": 26,
      "globalOrder": 4810,
      "pageNumber": 526,
      "juzNumber": 27,
      "arabicText": "وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَـٰوَٰتِ لَا تُغْنِى شَفَـٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ",
      "translationText": "Göklerde nice melek var ki Allah'ın dileyip razı olduğuna izin vermeden önce onların şefaatları hiç bir işe yaramaz.",
      "translationFootnotes": []
    },
    {
      "key": "53:27",
      "surahId": 53,
      "numberInSurah": 27,
      "globalOrder": 4811,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ لَيُسَمُّونَ ٱلْمَلَـٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ",
      "translationText": "Ahirete iman etmeyenler meleklere dişilerin adlarını takıp duruyorlar",
      "translationFootnotes": []
    },
    {
      "key": "53:28",
      "surahId": 53,
      "numberInSurah": 28,
      "globalOrder": 4812,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "وَمَا لَهُم بِهِۦ مِنْ عِلْمٍ ۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ ۖ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًٔا",
      "translationText": "Onların bu hususta bir bilgileri yoktur. Sadece zanna uyuyorlar. Zan ise, şüphesiz hakikat bakımından birşey ifade etmez.",
      "translationFootnotes": []
    },
    {
      "key": "53:29",
      "surahId": 53,
      "numberInSurah": 29,
      "globalOrder": 4813,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "translationText": "Onun için bizi anmaktan yüz çeviren ve dünya hayatından başka bir şey istemeyenlerden yüz çevir.",
      "translationFootnotes": []
    },
    {
      "key": "53:30",
      "surahId": 53,
      "numberInSurah": 30,
      "globalOrder": 4814,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "ذَٰلِكَ مَبْلَغُهُم مِّنَ ٱلْعِلْمِ ۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ ٱهْتَدَىٰ",
      "translationText": "İşte onların ilimden erişebilecekleri (son sınır) budur. Şüphesiz, Rabbin, yolundan sapanı da iyi bilir; O, hidayette olanı da iyi bilir.",
      "translationFootnotes": []
    },
    {
      "key": "53:31",
      "surahId": 53,
      "numberInSurah": 31,
      "globalOrder": 4815,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "وَلِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَـٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى",
      "translationText": "Göklerde ve yerde bulunanlar hep Allah'ındır. Akıbet (sonuçta) kötülük yapanları yaptıkları ile cezalandıracak, güzel davrananları da daha güzeliyle mükafatlandıracaktır.",
      "translationFootnotes": []
    },
    {
      "key": "53:32",
      "surahId": 53,
      "numberInSurah": 32,
      "globalOrder": 4816,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "ٱلَّذِينَ يَجْتَنِبُونَ كَبَـٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ ۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٌ فِى بُطُونِ أُمَّهَـٰتِكُمْ ۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ ۖ هُوَ أَعْلَمُ بِمَنِ ٱتَّقَىٰٓ",
      "translationText": "Onlar ki günahın büyüklerinden ve çirkin işlerden kaçınırlar, yalnız bazı küçük kusurlar hariç. Şüphesiz Rabbinin affı geniştir. O, sizi daha topraktan yarattığı zaman ve siz annelerinizin karınlarında bulunduğunuz sırada, sizi en iyi bilendir. Bunun için kendinizi temize çıkarmayın. Çünkü O, kötülükten sakınanı daha iyi bilir.",
      "translationFootnotes": []
    },
    {
      "key": "53:33",
      "surahId": 53,
      "numberInSurah": 33,
      "globalOrder": 4817,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "أَفَرَءَيْتَ ٱلَّذِى تَوَلَّىٰ",
      "translationText": "Şimdi gördün mü O yüz çevireni?",
      "translationFootnotes": []
    },
    {
      "key": "53:34",
      "surahId": 53,
      "numberInSurah": 34,
      "globalOrder": 4818,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "وَأَعْطَىٰ قَلِيلًا وَأَكْدَىٰٓ",
      "translationText": "Azıcık verip (sonra vermemekte) direneni?",
      "translationFootnotes": []
    },
    {
      "key": "53:35",
      "surahId": 53,
      "numberInSurah": 35,
      "globalOrder": 4819,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "أَعِندَهُۥ عِلْمُ ٱلْغَيْبِ فَهُوَ يَرَىٰٓ",
      "translationText": "Gaybın bilgisi kendi yanındadır da, o mu görüyor?",
      "translationFootnotes": []
    },
    {
      "key": "53:36",
      "surahId": 53,
      "numberInSurah": 36,
      "globalOrder": 4820,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "أَمْ لَمْ يُنَبَّأْ بِمَا فِى صُحُفِ مُوسَىٰ",
      "translationText": "Yoksa haber verilmedi mi Musa'nın sahifelerinde yazılı olanlar?",
      "translationFootnotes": []
    },
    {
      "key": "53:37",
      "surahId": 53,
      "numberInSurah": 37,
      "globalOrder": 4821,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "وَإِبْرَٰهِيمَ ٱلَّذِى وَفَّىٰٓ",
      "translationText": "Ve çok vefakâr olan İbrahim'in sahifelerindekiler?",
      "translationFootnotes": []
    },
    {
      "key": "53:38",
      "surahId": 53,
      "numberInSurah": 38,
      "globalOrder": 4822,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "أَلَّا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰ",
      "translationText": "Ki hiçbir günahkâr başkasının günah yükünü yüklenmez.",
      "translationFootnotes": []
    },
    {
      "key": "53:39",
      "surahId": 53,
      "numberInSurah": 39,
      "globalOrder": 4823,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "وَأَن لَّيْسَ لِلْإِنسَـٰنِ إِلَّا مَا سَعَىٰ",
      "translationText": "Doğrusu insana çalışmasından başka bir şey yoktur.",
      "translationFootnotes": []
    },
    {
      "key": "53:40",
      "surahId": 53,
      "numberInSurah": 40,
      "globalOrder": 4824,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "وَأَنَّ سَعْيَهُۥ سَوْفَ يُرَىٰ",
      "translationText": "Ve çalışması da yakında görülecektir.",
      "translationFootnotes": []
    },
    {
      "key": "53:41",
      "surahId": 53,
      "numberInSurah": 41,
      "globalOrder": 4825,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "ثُمَّ يُجْزَىٰهُ ٱلْجَزَآءَ ٱلْأَوْفَىٰ",
      "translationText": "Sonra ona karşılığı tastamam verilecektir.",
      "translationFootnotes": []
    },
    {
      "key": "53:42",
      "surahId": 53,
      "numberInSurah": 42,
      "globalOrder": 4826,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "وَأَنَّ إِلَىٰ رَبِّكَ ٱلْمُنتَهَىٰ",
      "translationText": "Ve şüphesiz en son varış, Rabbinedir.",
      "translationFootnotes": []
    },
    {
      "key": "53:43",
      "surahId": 53,
      "numberInSurah": 43,
      "globalOrder": 4827,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْكَىٰ",
      "translationText": "Doğrusu güldüren de ağlatan da O'dur.",
      "translationFootnotes": []
    },
    {
      "key": "53:44",
      "surahId": 53,
      "numberInSurah": 44,
      "globalOrder": 4828,
      "pageNumber": 527,
      "juzNumber": 27,
      "arabicText": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْيَا",
      "translationText": "Öldüren de dirilten de O'dur.",
      "translationFootnotes": []
    },
    {
      "key": "53:45",
      "surahId": 53,
      "numberInSurah": 45,
      "globalOrder": 4829,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ",
      "translationText": "Şüphesiz erkeği, dişiyi iki eş yaratan O'dur,",
      "translationFootnotes": []
    },
    {
      "key": "53:46",
      "surahId": 53,
      "numberInSurah": 46,
      "globalOrder": 4830,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "مِن نُّطْفَةٍ إِذَا تُمْنَىٰ",
      "translationText": "Atıldığı zaman bir nutfeden.",
      "translationFootnotes": []
    },
    {
      "key": "53:47",
      "surahId": 53,
      "numberInSurah": 47,
      "globalOrder": 4831,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "وَأَنَّ عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ",
      "translationText": "Şüphesiz tekrar diriltmek de O'na aittir.",
      "translationFootnotes": []
    },
    {
      "key": "53:48",
      "surahId": 53,
      "numberInSurah": 48,
      "globalOrder": 4832,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ",
      "translationText": "Şüphesiz zengin eden de sermaye veren de O'dur.",
      "translationFootnotes": []
    },
    {
      "key": "53:49",
      "surahId": 53,
      "numberInSurah": 49,
      "globalOrder": 4833,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعْرَىٰ",
      "translationText": "Doğrusu Şi'râ yıldızının Rabbi O'dur.",
      "translationFootnotes": []
    },
    {
      "key": "53:50",
      "surahId": 53,
      "numberInSurah": 50,
      "globalOrder": 4834,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ",
      "translationText": "O, helak etti önce gelen Âd'ı.",
      "translationFootnotes": []
    },
    {
      "key": "53:51",
      "surahId": 53,
      "numberInSurah": 51,
      "globalOrder": 4835,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "وَثَمُودَا۟ فَمَآ أَبْقَىٰ",
      "translationText": "Ve Semûd'u da bırakmadı.",
      "translationFootnotes": []
    },
    {
      "key": "53:52",
      "surahId": 53,
      "numberInSurah": 52,
      "globalOrder": 4836,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ",
      "translationText": "Önceden de Nuh kavmini (helak etmişti), çünkü onlar zulmetmiş ve azmıştı.",
      "translationFootnotes": []
    },
    {
      "key": "53:53",
      "surahId": 53,
      "numberInSurah": 53,
      "globalOrder": 4837,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "وَٱلْمُؤْتَفِكَةَ أَهْوَىٰ",
      "translationText": "Altı üstüne getirilmiş şehirleri devirip yıktı.",
      "translationFootnotes": []
    },
    {
      "key": "53:54",
      "surahId": 53,
      "numberInSurah": 54,
      "globalOrder": 4838,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "فَغَشَّىٰهَا مَا غَشَّىٰ",
      "translationText": "Onları neler kapladı neler!",
      "translationFootnotes": []
    },
    {
      "key": "53:55",
      "surahId": 53,
      "numberInSurah": 55,
      "globalOrder": 4839,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "فَبِأَىِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ",
      "translationText": "O halde Rabbinin hangi nimetinden kuşku duyuyorsun.",
      "translationFootnotes": []
    },
    {
      "key": "53:56",
      "surahId": 53,
      "numberInSurah": 56,
      "globalOrder": 4840,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "هَـٰذَا نَذِيرٌ مِّنَ ٱلنُّذُرِ ٱلْأُولَىٰٓ",
      "translationText": "Bu da ilk uyarıcılardan bir uyarıcıdır.",
      "translationFootnotes": []
    },
    {
      "key": "53:57",
      "surahId": 53,
      "numberInSurah": 57,
      "globalOrder": 4841,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "أَزِفَتِ ٱلْـَٔازِفَةُ",
      "translationText": "Yaklaşan yaklaştı.",
      "translationFootnotes": []
    },
    {
      "key": "53:58",
      "surahId": 53,
      "numberInSurah": 58,
      "globalOrder": 4842,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "لَيْسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ",
      "translationText": "Onu Allah'tan başka açığa çıkaracak yoktur.",
      "translationFootnotes": []
    },
    {
      "key": "53:59",
      "surahId": 53,
      "numberInSurah": 59,
      "globalOrder": 4843,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "أَفَمِنْ هَـٰذَا ٱلْحَدِيثِ تَعْجَبُونَ",
      "translationText": "Şimdi siz bu sözden mi hayret ediyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "53:60",
      "surahId": 53,
      "numberInSurah": 60,
      "globalOrder": 4844,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "وَتَضْحَكُونَ وَلَا تَبْكُونَ",
      "translationText": "Gülüyorsunuz da ağlamıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "53:61",
      "surahId": 53,
      "numberInSurah": 61,
      "globalOrder": 4845,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "وَأَنتُمْ سَـٰمِدُونَ",
      "translationText": "Ve siz mi kafa tutuyorsunuz ey gafiller?",
      "translationFootnotes": []
    },
    {
      "key": "53:62",
      "surahId": 53,
      "numberInSurah": 62,
      "globalOrder": 4846,
      "pageNumber": 528,
      "juzNumber": 27,
      "arabicText": "فَٱسْجُدُوا۟ لِلَّهِ وَٱعْبُدُوا۟ ۩",
      "translationText": "Haydi Allah için secdeye kapanın ve O'na kulluk edin.",
      "translationFootnotes": []
    }
  ]
}

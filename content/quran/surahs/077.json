{
  "schemaVersion": 1,
  "surah": {
    "id": 77,
    "nameArabic": "المرسلات",
    "nameTurkish": null,
    "verseCount": 50,
    "firstGlobalOrder": 5623
  },
  "verses": [
    {
      "key": "77:1",
      "surahId": 77,
      "numberInSurah": 1,
      "globalOrder": 5623,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "وَٱلْمُرْسَلَـٰتِ عُرْفًا",
      "translationText": "Andolsun birbiri ardınca gönderilenlere,",
      "translationFootnotes": []
    },
    {
      "key": "77:2",
      "surahId": 77,
      "numberInSurah": 2,
      "globalOrder": 5624,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "فَٱلْعَـٰصِفَـٰتِ عَصْفًا",
      "translationText": "Büküp devirenlere,",
      "translationFootnotes": []
    },
    {
      "key": "77:3",
      "surahId": 77,
      "numberInSurah": 3,
      "globalOrder": 5625,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "وَٱلنَّـٰشِرَٰتِ نَشْرًا",
      "translationText": "Yaydıkça yayanlara,",
      "translationFootnotes": []
    },
    {
      "key": "77:4",
      "surahId": 77,
      "numberInSurah": 4,
      "globalOrder": 5626,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "فَٱلْفَـٰرِقَـٰتِ فَرْقًا",
      "translationText": "Seçip ayıranlara,",
      "translationFootnotes": []
    },
    {
      "key": "77:5",
      "surahId": 77,
      "numberInSurah": 5,
      "globalOrder": 5627,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "فَٱلْمُلْقِيَـٰتِ ذِكْرًا",
      "translationText": "Bir öğüt bırakanlara,",
      "translationFootnotes": []
    },
    {
      "key": "77:6",
      "surahId": 77,
      "numberInSurah": 6,
      "globalOrder": 5628,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "عُذْرًا أَوْ نُذْرًا",
      "translationText": "Gerek özür için olsun, gerek uyarı için,",
      "translationFootnotes": []
    },
    {
      "key": "77:7",
      "surahId": 77,
      "numberInSurah": 7,
      "globalOrder": 5629,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ",
      "translationText": "Herhalde size vaad olunan kesinlikle olacaktır.",
      "translationFootnotes": []
    },
    {
      "key": "77:8",
      "surahId": 77,
      "numberInSurah": 8,
      "globalOrder": 5630,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ",
      "translationText": "Hani o yıldızlar silindiği zaman,",
      "translationFootnotes": []
    },
    {
      "key": "77:9",
      "surahId": 77,
      "numberInSurah": 9,
      "globalOrder": 5631,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ",
      "translationText": "Gök yarıldığı zaman,",
      "translationFootnotes": []
    },
    {
      "key": "77:10",
      "surahId": 77,
      "numberInSurah": 10,
      "globalOrder": 5632,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ",
      "translationText": "Dağlar savrulduğu zaman,",
      "translationFootnotes": []
    },
    {
      "key": "77:11",
      "surahId": 77,
      "numberInSurah": 11,
      "globalOrder": 5633,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ",
      "translationText": "Elçiler, tayin edilen vakitlerine erdirildikleri zaman,",
      "translationFootnotes": []
    },
    {
      "key": "77:12",
      "surahId": 77,
      "numberInSurah": 12,
      "globalOrder": 5634,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "لِأَىِّ يَوْمٍ أُجِّلَتْ",
      "translationText": "Bunlar hangi güne ertelendiler?",
      "translationFootnotes": []
    },
    {
      "key": "77:13",
      "surahId": 77,
      "numberInSurah": 13,
      "globalOrder": 5635,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "لِيَوْمِ ٱلْفَصْلِ",
      "translationText": "Hüküm gününe..",
      "translationFootnotes": []
    },
    {
      "key": "77:14",
      "surahId": 77,
      "numberInSurah": 14,
      "globalOrder": 5636,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ",
      "translationText": "Bildin mi, nedir o hüküm günü?",
      "translationFootnotes": []
    },
    {
      "key": "77:15",
      "surahId": 77,
      "numberInSurah": 15,
      "globalOrder": 5637,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationText": "O gün yalanlayanların vay haline!",
      "translationFootnotes": []
    },
    {
      "key": "77:16",
      "surahId": 77,
      "numberInSurah": 16,
      "globalOrder": 5638,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ",
      "translationText": "Biz, öncekileri helak etmedik mi?",
      "translationFootnotes": []
    },
    {
      "key": "77:17",
      "surahId": 77,
      "numberInSurah": 17,
      "globalOrder": 5639,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ",
      "translationText": "Sonra geridekileri de onlara katarız.",
      "translationFootnotes": []
    },
    {
      "key": "77:18",
      "surahId": 77,
      "numberInSurah": 18,
      "globalOrder": 5640,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
      "translationText": "Biz suçlulara böyle yaparız.",
      "translationFootnotes": []
    },
    {
      "key": "77:19",
      "surahId": 77,
      "numberInSurah": 19,
      "globalOrder": 5641,
      "pageNumber": 580,
      "juzNumber": 29,
      "arabicText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationText": "O gün yalanlayanların vah haline!",
      "translationFootnotes": []
    },
    {
      "key": "77:20",
      "surahId": 77,
      "numberInSurah": 20,
      "globalOrder": 5642,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ",
      "translationText": "Biz sizi âdi bir sudan yaratmadık mı?",
      "translationFootnotes": []
    },
    {
      "key": "77:21",
      "surahId": 77,
      "numberInSurah": 21,
      "globalOrder": 5643,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ",
      "translationText": "Onu sağlam bir yerde oturttuk.",
      "translationFootnotes": []
    },
    {
      "key": "77:22",
      "surahId": 77,
      "numberInSurah": 22,
      "globalOrder": 5644,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "إِلَىٰ قَدَرٍ مَّعْلُومٍ",
      "translationText": "Belli bir süreye kadar.",
      "translationFootnotes": []
    },
    {
      "key": "77:23",
      "surahId": 77,
      "numberInSurah": 23,
      "globalOrder": 5645,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ",
      "translationText": "Demek ki biçimlendirmişiz. Ne güzel biçimlendireniz biz.",
      "translationFootnotes": []
    },
    {
      "key": "77:24",
      "surahId": 77,
      "numberInSurah": 24,
      "globalOrder": 5646,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationText": "O gün yalanlayanların vay haline!",
      "translationFootnotes": []
    },
    {
      "key": "77:25",
      "surahId": 77,
      "numberInSurah": 25,
      "globalOrder": 5647,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",
      "translationText": "Yeryüzünü bir tokat (toplanma yeri) yapmadık mı?",
      "translationFootnotes": []
    },
    {
      "key": "77:26",
      "surahId": 77,
      "numberInSurah": 26,
      "globalOrder": 5648,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "أَحْيَآءً وَأَمْوَٰتًا",
      "translationText": "Gerek diriler, gerekse ölüler için.",
      "translationFootnotes": []
    },
    {
      "key": "77:27",
      "surahId": 77,
      "numberInSurah": 27,
      "globalOrder": 5649,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا",
      "translationText": "Orada yüksek yüksek dağlar oturtup da size bir tatlı su sunmadık mı?",
      "translationFootnotes": []
    },
    {
      "key": "77:28",
      "surahId": 77,
      "numberInSurah": 28,
      "globalOrder": 5650,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationText": "O gün yalanlayanların vay haline!",
      "translationFootnotes": []
    },
    {
      "key": "77:29",
      "surahId": 77,
      "numberInSurah": 29,
      "globalOrder": 5651,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
      "translationText": "(Kıyameti yalanlayanlara şöyle denir): \"Haydin gidin o yalanladığınız şeye doğru.\"",
      "translationFootnotes": []
    },
    {
      "key": "77:30",
      "surahId": 77,
      "numberInSurah": 30,
      "globalOrder": 5652,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ",
      "translationText": "\"Haydi gidin o üç çatallı gölgeye (cehenneme).\"",
      "translationFootnotes": []
    },
    {
      "key": "77:31",
      "surahId": 77,
      "numberInSurah": 31,
      "globalOrder": 5653,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ",
      "translationText": "O, ne gölgelendirir, ne alevden korur.",
      "translationFootnotes": []
    },
    {
      "key": "77:32",
      "surahId": 77,
      "numberInSurah": 32,
      "globalOrder": 5654,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ",
      "translationText": "O, saray gibi kıvılcımlar atar.",
      "translationFootnotes": []
    },
    {
      "key": "77:33",
      "surahId": 77,
      "numberInSurah": 33,
      "globalOrder": 5655,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ",
      "translationText": "Sanki o kıvılcımlar, sarı sarı (erkek deve sürüleridir).",
      "translationFootnotes": []
    },
    {
      "key": "77:34",
      "surahId": 77,
      "numberInSurah": 34,
      "globalOrder": 5656,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationText": "O gün yalanlayanların vay haline!",
      "translationFootnotes": []
    },
    {
      "key": "77:35",
      "surahId": 77,
      "numberInSurah": 35,
      "globalOrder": 5657,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "هَـٰذَا يَوْمُ لَا يَنطِقُونَ",
      "translationText": "Bugün, konuşamıyacakları gündür.",
      "translationFootnotes": []
    },
    {
      "key": "77:36",
      "surahId": 77,
      "numberInSurah": 36,
      "globalOrder": 5658,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ",
      "translationText": "Kendilerine izin de verilmez ki, özür beyan etsinler.",
      "translationFootnotes": []
    },
    {
      "key": "77:37",
      "surahId": 77,
      "numberInSurah": 37,
      "globalOrder": 5659,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationText": "O gün yalanlayanların vay haline!",
      "translationFootnotes": []
    },
    {
      "key": "77:38",
      "surahId": 77,
      "numberInSurah": 38,
      "globalOrder": 5660,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ",
      "translationText": "Bu, işte o hüküm günüdür. Sizi ve öncekileri bir araya topladık.",
      "translationFootnotes": []
    },
    {
      "key": "77:39",
      "surahId": 77,
      "numberInSurah": 39,
      "globalOrder": 5661,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ",
      "translationText": "Bir hileniz varsa beni atlatın.",
      "translationFootnotes": []
    },
    {
      "key": "77:40",
      "surahId": 77,
      "numberInSurah": 40,
      "globalOrder": 5662,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationText": "O gün yalanlayanların vay haline!",
      "translationFootnotes": []
    },
    {
      "key": "77:41",
      "surahId": 77,
      "numberInSurah": 41,
      "globalOrder": 5663,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ",
      "translationText": "Kuşkusuz takva sahipleri gölgeler altında ve pınar başlarındadır.",
      "translationFootnotes": []
    },
    {
      "key": "77:42",
      "surahId": 77,
      "numberInSurah": 42,
      "globalOrder": 5664,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ",
      "translationText": "Canlarının çektiğinden türlü meyveler arasındadırlar.",
      "translationFootnotes": []
    },
    {
      "key": "77:43",
      "surahId": 77,
      "numberInSurah": 43,
      "globalOrder": 5665,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ",
      "translationText": "(Onlara): \"Yaptıklarınıza karşılık afiyetle yiyin, için\" (denir).",
      "translationFootnotes": []
    },
    {
      "key": "77:44",
      "surahId": 77,
      "numberInSurah": 44,
      "globalOrder": 5666,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
      "translationText": "İşte biz güzel amel işleyenleri böyle mükafatlandırırız.",
      "translationFootnotes": []
    },
    {
      "key": "77:45",
      "surahId": 77,
      "numberInSurah": 45,
      "globalOrder": 5667,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationText": "O gün yalanlayanların vay haline!",
      "translationFootnotes": []
    },
    {
      "key": "77:46",
      "surahId": 77,
      "numberInSurah": 46,
      "globalOrder": 5668,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ",
      "translationText": "Yiyin, zevklenin biraz, çünkü siz suçlularsınız.",
      "translationFootnotes": []
    },
    {
      "key": "77:47",
      "surahId": 77,
      "numberInSurah": 47,
      "globalOrder": 5669,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationText": "O gün yalanlayanların vay haline!",
      "translationFootnotes": []
    },
    {
      "key": "77:48",
      "surahId": 77,
      "numberInSurah": 48,
      "globalOrder": 5670,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ",
      "translationText": "Onlara: \"Rüku edin\" denildiği zaman etmezler.",
      "translationFootnotes": []
    },
    {
      "key": "77:49",
      "surahId": 77,
      "numberInSurah": 49,
      "globalOrder": 5671,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationText": "Vay haline o gün yalanlayanların!",
      "translationFootnotes": []
    },
    {
      "key": "77:50",
      "surahId": 77,
      "numberInSurah": 50,
      "globalOrder": 5672,
      "pageNumber": 581,
      "juzNumber": 29,
      "arabicText": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ",
      "translationText": "Artık bundan (Kur'an'dan) sonra hangi söze inanacaklar?",
      "translationFootnotes": []
    }
  ]
}

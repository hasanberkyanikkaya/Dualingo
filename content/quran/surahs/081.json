{
  "schemaVersion": 1,
  "surah": {
    "id": 81,
    "nameArabic": "التكوير",
    "nameTurkish": "Tekvir Sûresi",
    "verseCount": 29,
    "firstGlobalOrder": 5801
  },
  "verses": [
    {
      "key": "81:1",
      "surahId": 81,
      "numberInSurah": 1,
      "globalOrder": 5801,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "إِذَا ٱلشَّمْسُ كُوِّرَتْ",
      "translationText": "Güneş katlanıp dürüldüğünde,",
      "translationFootnotes": []
    },
    {
      "key": "81:2",
      "surahId": 81,
      "numberInSurah": 2,
      "globalOrder": 5802,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
      "translationText": "Yıldızlar bulandığında,",
      "translationFootnotes": []
    },
    {
      "key": "81:3",
      "surahId": 81,
      "numberInSurah": 3,
      "globalOrder": 5803,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
      "translationText": "Dağlar yürütüldüğünde,",
      "translationFootnotes": []
    },
    {
      "key": "81:4",
      "surahId": 81,
      "numberInSurah": 4,
      "globalOrder": 5804,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
      "translationText": "Kıyılmaz mallar bırakıldığında,",
      "translationFootnotes": []
    },
    {
      "key": "81:5",
      "surahId": 81,
      "numberInSurah": 5,
      "globalOrder": 5805,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
      "translationText": "Vahşi hayvanlar bir araya toplandığında,",
      "translationFootnotes": []
    },
    {
      "key": "81:6",
      "surahId": 81,
      "numberInSurah": 6,
      "globalOrder": 5806,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
      "translationText": "Denizler ateşlendiğinde (suları çekilip, volkanlar halinde ateş püskürdüğünde),",
      "translationFootnotes": []
    },
    {
      "key": "81:7",
      "surahId": 81,
      "numberInSurah": 7,
      "globalOrder": 5807,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
      "translationText": "Nefisler eşleştirildiğinde (iyiler iyilerle, kötüler kötülerle bir araya toplandığında),",
      "translationFootnotes": []
    },
    {
      "key": "81:8",
      "surahId": 81,
      "numberInSurah": 8,
      "globalOrder": 5808,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
      "translationText": "Diri diri toprağa gömülen kıza sorulduğunda,",
      "translationFootnotes": []
    },
    {
      "key": "81:9",
      "surahId": 81,
      "numberInSurah": 9,
      "globalOrder": 5809,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
      "translationText": "\"Hangi günahtan dolayı öldürüldü?\" diye.",
      "translationFootnotes": []
    },
    {
      "key": "81:10",
      "surahId": 81,
      "numberInSurah": 10,
      "globalOrder": 5810,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
      "translationText": "Amel defterleri açıldığında,",
      "translationFootnotes": []
    },
    {
      "key": "81:11",
      "surahId": 81,
      "numberInSurah": 11,
      "globalOrder": 5811,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
      "translationText": "Gök sıyrılıp açıldığında,",
      "translationFootnotes": []
    },
    {
      "key": "81:12",
      "surahId": 81,
      "numberInSurah": 12,
      "globalOrder": 5812,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
      "translationText": "Cehennem kızıştırıldığında,",
      "translationFootnotes": []
    },
    {
      "key": "81:13",
      "surahId": 81,
      "numberInSurah": 13,
      "globalOrder": 5813,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
      "translationText": "Ve cennet yaklaştırıldığında,",
      "translationFootnotes": []
    },
    {
      "key": "81:14",
      "surahId": 81,
      "numberInSurah": 14,
      "globalOrder": 5814,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
      "translationText": "Herkes ne getirmiş olduğunu anlar.",
      "translationFootnotes": []
    },
    {
      "key": "81:15",
      "surahId": 81,
      "numberInSurah": 15,
      "globalOrder": 5815,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
      "translationText": "Şimdi yemin ederim o sinenlere (gündüzleri gözden kaybolan yıldızlara),",
      "translationFootnotes": []
    },
    {
      "key": "81:16",
      "surahId": 81,
      "numberInSurah": 16,
      "globalOrder": 5816,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "ٱلْجَوَارِ ٱلْكُنَّسِ",
      "translationText": "O akıp akıp yuvasına gidenlere,",
      "translationFootnotes": []
    },
    {
      "key": "81:17",
      "surahId": 81,
      "numberInSurah": 17,
      "globalOrder": 5817,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
      "translationText": "Yöneldiği an geceye,",
      "translationFootnotes": []
    },
    {
      "key": "81:18",
      "surahId": 81,
      "numberInSurah": 18,
      "globalOrder": 5818,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
      "translationText": "Nefeslendiği (ağardığı) an sabaha ki,",
      "translationFootnotes": []
    },
    {
      "key": "81:19",
      "surahId": 81,
      "numberInSurah": 19,
      "globalOrder": 5819,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
      "translationText": "Kuşkusuz o Kur'an, değerli bir elçinin sözüdür.",
      "translationFootnotes": []
    },
    {
      "key": "81:20",
      "surahId": 81,
      "numberInSurah": 20,
      "globalOrder": 5820,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
      "translationText": "O elçi güçlüdür, Arş'ın sahibinin yanında çok itibarlıdır.",
      "translationFootnotes": []
    },
    {
      "key": "81:21",
      "surahId": 81,
      "numberInSurah": 21,
      "globalOrder": 5821,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "مُّطَاعٍ ثَمَّ أَمِينٍ",
      "translationText": "Orada ona itaat edilir, güvenilir.",
      "translationFootnotes": []
    },
    {
      "key": "81:22",
      "surahId": 81,
      "numberInSurah": 22,
      "globalOrder": 5822,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
      "translationText": "Arkadaşınızı cin çarpmış değildir.",
      "translationFootnotes": []
    },
    {
      "key": "81:23",
      "surahId": 81,
      "numberInSurah": 23,
      "globalOrder": 5823,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
      "translationText": "Andolsun o, Cebrail'i açık ufukta gördü.",
      "translationFootnotes": []
    },
    {
      "key": "81:24",
      "surahId": 81,
      "numberInSurah": 24,
      "globalOrder": 5824,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
      "translationText": "O, gayb hakkında cimri de değildir.",
      "translationFootnotes": []
    },
    {
      "key": "81:25",
      "surahId": 81,
      "numberInSurah": 25,
      "globalOrder": 5825,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
      "translationText": "O, kovulmuş bir şeytanın sözü değildir.",
      "translationFootnotes": []
    },
    {
      "key": "81:26",
      "surahId": 81,
      "numberInSurah": 26,
      "globalOrder": 5826,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "فَأَيْنَ تَذْهَبُونَ",
      "translationText": "Hâl böyle iken, siz nereye gidiyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "81:27",
      "surahId": 81,
      "numberInSurah": 27,
      "globalOrder": 5827,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
      "translationText": "O, âlemler için öğütten başka bir şey değildir,",
      "translationFootnotes": []
    },
    {
      "key": "81:28",
      "surahId": 81,
      "numberInSurah": 28,
      "globalOrder": 5828,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
      "translationText": "İçinizden doğru gitmek isteyenler için.",
      "translationFootnotes": []
    },
    {
      "key": "81:29",
      "surahId": 81,
      "numberInSurah": 29,
      "globalOrder": 5829,
      "pageNumber": 586,
      "juzNumber": 30,
      "arabicText": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
      "translationText": "Âlemlerin Rabbi olan Allah dilemeyince, siz dileyemezsiniz.",
      "translationFootnotes": []
    }
  ]
}

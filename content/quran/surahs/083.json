{
  "schemaVersion": 1,
  "surah": {
    "id": 83,
    "nameArabic": "المطففين",
    "nameTurkish": "Mutaffifin Sûresi",
    "verseCount": 36,
    "firstGlobalOrder": 5849
  },
  "verses": [
    {
      "key": "83:1",
      "surahId": 83,
      "numberInSurah": 1,
      "globalOrder": 5849,
      "pageNumber": 587,
      "juzNumber": 30,
      "arabicText": "وَيْلٌ لِّلْمُطَفِّفِينَ",
      "translationText": "Eksik ölçüp tartanların vay haline!",
      "translationFootnotes": []
    },
    {
      "key": "83:2",
      "surahId": 83,
      "numberInSurah": 2,
      "globalOrder": 5850,
      "pageNumber": 587,
      "juzNumber": 30,
      "arabicText": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ",
      "translationText": "Onlar insanlardan kendilerine bir şey aldıkları zaman tam ölçerler.",
      "translationFootnotes": []
    },
    {
      "key": "83:3",
      "surahId": 83,
      "numberInSurah": 3,
      "globalOrder": 5851,
      "pageNumber": 587,
      "juzNumber": 30,
      "arabicText": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ",
      "translationText": "Kendileri başkalarına bir şey ölçtükleri veya tarttıkları zaman eksik ölçer ve tartarlar.",
      "translationFootnotes": []
    },
    {
      "key": "83:4",
      "surahId": 83,
      "numberInSurah": 4,
      "globalOrder": 5852,
      "pageNumber": 587,
      "juzNumber": 30,
      "arabicText": "أَلَا يَظُنُّ أُو۟لَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ",
      "translationText": "Onlar tekrar diriltileceklerini zannetmiyorlar mı?",
      "translationFootnotes": []
    },
    {
      "key": "83:5",
      "surahId": 83,
      "numberInSurah": 5,
      "globalOrder": 5853,
      "pageNumber": 587,
      "juzNumber": 30,
      "arabicText": "لِيَوْمٍ عَظِيمٍ",
      "translationText": "Büyük bir gün için.",
      "translationFootnotes": []
    },
    {
      "key": "83:6",
      "surahId": 83,
      "numberInSurah": 6,
      "globalOrder": 5854,
      "pageNumber": 587,
      "juzNumber": 30,
      "arabicText": "يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَـٰلَمِينَ",
      "translationText": "Öyle bir gün ki, insanlar o gün Rabblerinin huzurunda divan duracaklar.",
      "translationFootnotes": []
    },
    {
      "key": "83:7",
      "surahId": 83,
      "numberInSurah": 7,
      "globalOrder": 5855,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "كَلَّآ إِنَّ كِتَـٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍ",
      "translationText": "Hayır hayır, kötülerin yazısı muhakkak Siccin'dedir.",
      "translationFootnotes": []
    },
    {
      "key": "83:8",
      "surahId": 83,
      "numberInSurah": 8,
      "globalOrder": 5856,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "وَمَآ أَدْرَىٰكَ مَا سِجِّينٌ",
      "translationText": "Bildin mi sen, Siccin nedir?",
      "translationFootnotes": []
    },
    {
      "key": "83:9",
      "surahId": 83,
      "numberInSurah": 9,
      "globalOrder": 5857,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "كِتَـٰبٌ مَّرْقُومٌ",
      "translationText": "Yazılmış bir kitaptır o.",
      "translationFootnotes": []
    },
    {
      "key": "83:10",
      "surahId": 83,
      "numberInSurah": 10,
      "globalOrder": 5858,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationText": "Vay haline yalanlayanların o gün!",
      "translationFootnotes": []
    },
    {
      "key": "83:11",
      "surahId": 83,
      "numberInSurah": 11,
      "globalOrder": 5859,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ",
      "translationText": "Onlar ceza gününü yalanlayanlardır.",
      "translationFootnotes": []
    },
    {
      "key": "83:12",
      "surahId": 83,
      "numberInSurah": 12,
      "globalOrder": 5860,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ",
      "translationText": "Onu ancak sınırı aşan ve günaha düşkün olanlar yalanlar.",
      "translationFootnotes": []
    },
    {
      "key": "83:13",
      "surahId": 83,
      "numberInSurah": 13,
      "globalOrder": 5861,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ",
      "translationText": "Ona âyetlerimiz okunduğu zaman, \"eskilerin masalları\" der.",
      "translationFootnotes": []
    },
    {
      "key": "83:14",
      "surahId": 83,
      "numberInSurah": 14,
      "globalOrder": 5862,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ",
      "translationText": "Hayır hayır, öyle değil. Aksine onların kazandığı günahlar kalplerinin üzerine pas olmuştur.",
      "translationFootnotes": []
    },
    {
      "key": "83:15",
      "surahId": 83,
      "numberInSurah": 15,
      "globalOrder": 5863,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍ لَّمَحْجُوبُونَ",
      "translationText": "Hayır hayır, doğrusu onlar o gün Rablerini görmekten mahrumdurlar.",
      "translationFootnotes": []
    },
    {
      "key": "83:16",
      "surahId": 83,
      "numberInSurah": 16,
      "globalOrder": 5864,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ",
      "translationText": "Sonra onlar muhakkak cehenneme girecekler.",
      "translationFootnotes": []
    },
    {
      "key": "83:17",
      "surahId": 83,
      "numberInSurah": 17,
      "globalOrder": 5865,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "ثُمَّ يُقَالُ هَـٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ",
      "translationText": "Sonra da onlara: \"İşte bu, yalanlayıp durduğunuz şeydir\" denilecek.",
      "translationFootnotes": []
    },
    {
      "key": "83:18",
      "surahId": 83,
      "numberInSurah": 18,
      "globalOrder": 5866,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "كَلَّآ إِنَّ كِتَـٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ",
      "translationText": "Hayır hayır, iyilerin yazısı muhakkak Illiyyîn'dedir.",
      "translationFootnotes": []
    },
    {
      "key": "83:19",
      "surahId": 83,
      "numberInSurah": 19,
      "globalOrder": 5867,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ",
      "translationText": "Bildin mi sen, Illiyyîn nedir?",
      "translationFootnotes": []
    },
    {
      "key": "83:20",
      "surahId": 83,
      "numberInSurah": 20,
      "globalOrder": 5868,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "كِتَـٰبٌ مَّرْقُومٌ",
      "translationText": "Yazılmış bir kitaptır o.",
      "translationFootnotes": []
    },
    {
      "key": "83:21",
      "surahId": 83,
      "numberInSurah": 21,
      "globalOrder": 5869,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "يَشْهَدُهُ ٱلْمُقَرَّبُونَ",
      "translationText": "Allah'a yaklaştırılmış melekler ona tanık olurlar.",
      "translationFootnotes": []
    },
    {
      "key": "83:22",
      "surahId": 83,
      "numberInSurah": 22,
      "globalOrder": 5870,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ",
      "translationText": "Haberiniz olsun ki, iyiler nimet içindedir.",
      "translationFootnotes": []
    },
    {
      "key": "83:23",
      "surahId": 83,
      "numberInSurah": 23,
      "globalOrder": 5871,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ",
      "translationText": "Tahtlar üzerinde etrafa bakarlar.",
      "translationFootnotes": []
    },
    {
      "key": "83:24",
      "surahId": 83,
      "numberInSurah": 24,
      "globalOrder": 5872,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ",
      "translationText": "Yüzlerinde nimet ve mutluluğun sevincini görürsün.",
      "translationFootnotes": []
    },
    {
      "key": "83:25",
      "surahId": 83,
      "numberInSurah": 25,
      "globalOrder": 5873,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "يُسْقَوْنَ مِن رَّحِيقٍ مَّخْتُومٍ",
      "translationText": "Onlara damgalı saf bir içki sunulur.",
      "translationFootnotes": []
    },
    {
      "key": "83:26",
      "surahId": 83,
      "numberInSurah": 26,
      "globalOrder": 5874,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "خِتَـٰمُهُۥ مِسْكٌ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَـٰفِسُونَ",
      "translationText": "Onun sonu misktir. İşte ona imrensin artık imrenenler.",
      "translationFootnotes": []
    },
    {
      "key": "83:27",
      "surahId": 83,
      "numberInSurah": 27,
      "globalOrder": 5875,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ",
      "translationText": "Karışımı Tesnim'dendir (En üstün cennet şarabındandır).",
      "translationFootnotes": []
    },
    {
      "key": "83:28",
      "surahId": 83,
      "numberInSurah": 28,
      "globalOrder": 5876,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "عَيْنًا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ",
      "translationText": "Allah'a yakın olanların içecekleri bir kaynaktır o.",
      "translationFootnotes": []
    },
    {
      "key": "83:29",
      "surahId": 83,
      "numberInSurah": 29,
      "globalOrder": 5877,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ",
      "translationText": "Doğrusu o suç işleyenler inananlara gülüyorlardı.",
      "translationFootnotes": []
    },
    {
      "key": "83:30",
      "surahId": 83,
      "numberInSurah": 30,
      "globalOrder": 5878,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ",
      "translationText": "Onlara uğradıkları vakit birbirlerine göz kırpıyorlardı.",
      "translationFootnotes": []
    },
    {
      "key": "83:31",
      "surahId": 83,
      "numberInSurah": 31,
      "globalOrder": 5879,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ",
      "translationText": "Evlerine döndükleri zaman zevklenerek dönüyorlardı.",
      "translationFootnotes": []
    },
    {
      "key": "83:32",
      "surahId": 83,
      "numberInSurah": 32,
      "globalOrder": 5880,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَـٰٓؤُلَآءِ لَضَآلُّونَ",
      "translationText": "Müminleri gördükleri vakit; \"işte bunlar sapıklar\" diyorlardı.",
      "translationFootnotes": []
    },
    {
      "key": "83:33",
      "surahId": 83,
      "numberInSurah": 33,
      "globalOrder": 5881,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَـٰفِظِينَ",
      "translationText": "Oysa onlar müminler üzerine bekçi olarak gönderilmemişlerdi.",
      "translationFootnotes": []
    },
    {
      "key": "83:34",
      "surahId": 83,
      "numberInSurah": 34,
      "globalOrder": 5882,
      "pageNumber": 588,
      "juzNumber": 30,
      "arabicText": "فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ",
      "translationText": "İşte bugün de inananlar kâfirlere gülecek.",
      "translationFootnotes": []
    },
    {
      "key": "83:35",
      "surahId": 83,
      "numberInSurah": 35,
      "globalOrder": 5883,
      "pageNumber": 589,
      "juzNumber": 30,
      "arabicText": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ",
      "translationText": "Koltuklar üzerinde etrafa bakacaklar.",
      "translationFootnotes": []
    },
    {
      "key": "83:36",
      "surahId": 83,
      "numberInSurah": 36,
      "globalOrder": 5884,
      "pageNumber": 589,
      "juzNumber": 30,
      "arabicText": "هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ",
      "translationText": "Nasıl, kâfirler yaptıklarının cezasını buldular mı?",
      "translationFootnotes": []
    }
  ]
}

{
  "schemaVersion": 1,
  "surah": {
    "id": 56,
    "nameArabic": "الواقعة",
    "nameTurkish": "Vâkıa Sûresi",
    "verseCount": 96,
    "firstGlobalOrder": 4980
  },
  "verses": [
    {
      "key": "56:1",
      "surahId": 56,
      "numberInSurah": 1,
      "globalOrder": 4980,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "إِذَا وَقَعَتِ ٱلْوَاقِعَةُ",
      "translationText": "Olacak vak'a olduğu zaman",
      "translationFootnotes": []
    },
    {
      "key": "56:2",
      "surahId": 56,
      "numberInSurah": 2,
      "globalOrder": 4981,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ",
      "translationText": "Onun oluşunu yalanlayacak kimse yoktur.",
      "translationFootnotes": []
    },
    {
      "key": "56:3",
      "surahId": 56,
      "numberInSurah": 3,
      "globalOrder": 4982,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "خَافِضَةٌ رَّافِعَةٌ",
      "translationText": "O, alçaltıcıdır, yükselticidir.",
      "translationFootnotes": []
    },
    {
      "key": "56:4",
      "surahId": 56,
      "numberInSurah": 4,
      "globalOrder": 4983,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا",
      "translationText": "Yer şiddetle sarsıldığı",
      "translationFootnotes": []
    },
    {
      "key": "56:5",
      "surahId": 56,
      "numberInSurah": 5,
      "globalOrder": 4984,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "وَبُسَّتِ ٱلْجِبَالُ بَسًّا",
      "translationText": "Dağlar serpildikçe serpildiği",
      "translationFootnotes": []
    },
    {
      "key": "56:6",
      "surahId": 56,
      "numberInSurah": 6,
      "globalOrder": 4985,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "فَكَانَتْ هَبَآءً مُّنۢبَثًّا",
      "translationText": "Dağılıp toz duman haline geldiği",
      "translationFootnotes": []
    },
    {
      "key": "56:7",
      "surahId": 56,
      "numberInSurah": 7,
      "globalOrder": 4986,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "وَكُنتُمْ أَزْوَٰجًا ثَلَـٰثَةً",
      "translationText": "Ve sizler üç sınıf olduğunuz zaman",
      "translationFootnotes": []
    },
    {
      "key": "56:8",
      "surahId": 56,
      "numberInSurah": 8,
      "globalOrder": 4987,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "فَأَصْحَـٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ",
      "translationText": "Sağın adamları (var ya) ne mutludurlar onlar!",
      "translationFootnotes": []
    },
    {
      "key": "56:9",
      "surahId": 56,
      "numberInSurah": 9,
      "globalOrder": 4988,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "وَأَصْحَـٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ",
      "translationText": "Solun adamları ise ne uğursuzdurlar onlar!",
      "translationFootnotes": []
    },
    {
      "key": "56:10",
      "surahId": 56,
      "numberInSurah": 10,
      "globalOrder": 4989,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ",
      "translationText": "Önde olanlar (var ya), onlar öncüdürler.",
      "translationFootnotes": []
    },
    {
      "key": "56:11",
      "surahId": 56,
      "numberInSurah": 11,
      "globalOrder": 4990,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "أُو۟لَـٰٓئِكَ ٱلْمُقَرَّبُونَ",
      "translationText": "İşte o yaklaştırılanlar,",
      "translationFootnotes": []
    },
    {
      "key": "56:12",
      "surahId": 56,
      "numberInSurah": 12,
      "globalOrder": 4991,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "فِى جَنَّـٰتِ ٱلنَّعِيمِ",
      "translationText": "Nimet cennetlerindedirler.",
      "translationFootnotes": []
    },
    {
      "key": "56:13",
      "surahId": 56,
      "numberInSurah": 13,
      "globalOrder": 4992,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ",
      "translationText": "Çoğu önceki ümmetlerden,",
      "translationFootnotes": []
    },
    {
      "key": "56:14",
      "surahId": 56,
      "numberInSurah": 14,
      "globalOrder": 4993,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "وَقَلِيلٌ مِّنَ ٱلْـَٔاخِرِينَ",
      "translationText": "Birazı da sonrakilerden.",
      "translationFootnotes": []
    },
    {
      "key": "56:15",
      "surahId": 56,
      "numberInSurah": 15,
      "globalOrder": 4994,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "عَلَىٰ سُرُرٍ مَّوْضُونَةٍ",
      "translationText": "(Onlar) cevherlerle işlenmiş tahtlar üzerindedirler.",
      "translationFootnotes": []
    },
    {
      "key": "56:16",
      "surahId": 56,
      "numberInSurah": 16,
      "globalOrder": 4995,
      "pageNumber": 534,
      "juzNumber": 27,
      "arabicText": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَـٰبِلِينَ",
      "translationText": "Karşılıklı olarak onların üzerinde yaslanırlar.",
      "translationFootnotes": []
    },
    {
      "key": "56:17",
      "surahId": 56,
      "numberInSurah": 17,
      "globalOrder": 4996,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ",
      "translationText": "Çevrelerinde, ölümsüzlüğe ulaşmış gençler dolaşırlar.",
      "translationFootnotes": []
    },
    {
      "key": "56:18",
      "surahId": 56,
      "numberInSurah": 18,
      "globalOrder": 4997,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ",
      "translationText": "Kaynağından doldurulmuş, testiler, ibrikler ve kadehlerle.",
      "translationFootnotes": []
    },
    {
      "key": "56:19",
      "surahId": 56,
      "numberInSurah": 19,
      "globalOrder": 4998,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ",
      "translationText": "Ondan ne başları ağrıtılır, ne de akılları giderilir.",
      "translationFootnotes": []
    },
    {
      "key": "56:20",
      "surahId": 56,
      "numberInSurah": 20,
      "globalOrder": 4999,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "وَفَـٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ",
      "translationText": "Beğendikleri meyvalar,",
      "translationFootnotes": []
    },
    {
      "key": "56:21",
      "surahId": 56,
      "numberInSurah": 21,
      "globalOrder": 5000,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ",
      "translationText": "Canlarının çektiği kuş etleri,",
      "translationFootnotes": []
    },
    {
      "key": "56:22",
      "surahId": 56,
      "numberInSurah": 22,
      "globalOrder": 5001,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "وَحُورٌ عِينٌ",
      "translationText": "İri gözlü hûriler,",
      "translationFootnotes": []
    },
    {
      "key": "56:23",
      "surahId": 56,
      "numberInSurah": 23,
      "globalOrder": 5002,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "كَأَمْثَـٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ",
      "translationText": "Saklı inciler gibi,",
      "translationFootnotes": []
    },
    {
      "key": "56:24",
      "surahId": 56,
      "numberInSurah": 24,
      "globalOrder": 5003,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ",
      "translationText": "Yaptıklarına karşılık olarak verilir.",
      "translationFootnotes": []
    },
    {
      "key": "56:25",
      "surahId": 56,
      "numberInSurah": 25,
      "globalOrder": 5004,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا",
      "translationText": "Orada boş bir söz ve günaha sokan bir laf işitmezler.",
      "translationFootnotes": []
    },
    {
      "key": "56:26",
      "surahId": 56,
      "numberInSurah": 26,
      "globalOrder": 5005,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "إِلَّا قِيلًا سَلَـٰمًا سَلَـٰمًا",
      "translationText": "Duydukları söz, yalnız \"selam\", \"selam\" dır.",
      "translationFootnotes": []
    },
    {
      "key": "56:27",
      "surahId": 56,
      "numberInSurah": 27,
      "globalOrder": 5006,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "وَأَصْحَـٰبُ ٱلْيَمِينِ مَآ أَصْحَـٰبُ ٱلْيَمِينِ",
      "translationText": "Sağın adamları, nedir o sağın adamları!",
      "translationFootnotes": []
    },
    {
      "key": "56:28",
      "surahId": 56,
      "numberInSurah": 28,
      "globalOrder": 5007,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "فِى سِدْرٍ مَّخْضُودٍ",
      "translationText": "Dalbastı kirazlar,",
      "translationFootnotes": []
    },
    {
      "key": "56:29",
      "surahId": 56,
      "numberInSurah": 29,
      "globalOrder": 5008,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "وَطَلْحٍ مَّنضُودٍ",
      "translationText": "Meyva dizili muzlar,",
      "translationFootnotes": []
    },
    {
      "key": "56:30",
      "surahId": 56,
      "numberInSurah": 30,
      "globalOrder": 5009,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "وَظِلٍّ مَّمْدُودٍ",
      "translationText": "Uzamış gölgeler,",
      "translationFootnotes": []
    },
    {
      "key": "56:31",
      "surahId": 56,
      "numberInSurah": 31,
      "globalOrder": 5010,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "وَمَآءٍ مَّسْكُوبٍ",
      "translationText": "Fışkıran sular.",
      "translationFootnotes": []
    },
    {
      "key": "56:32",
      "surahId": 56,
      "numberInSurah": 32,
      "globalOrder": 5011,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "وَفَـٰكِهَةٍ كَثِيرَةٍ",
      "translationText": "Pek çok meyva arasında,",
      "translationFootnotes": []
    },
    {
      "key": "56:33",
      "surahId": 56,
      "numberInSurah": 33,
      "globalOrder": 5012,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ",
      "translationText": "Tükenmeyen ve yasaklanmayan",
      "translationFootnotes": []
    },
    {
      "key": "56:34",
      "surahId": 56,
      "numberInSurah": 34,
      "globalOrder": 5013,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "وَفُرُشٍ مَّرْفُوعَةٍ",
      "translationText": "Ve yükseltilmiş döşekler üstündedirler.",
      "translationFootnotes": []
    },
    {
      "key": "56:35",
      "surahId": 56,
      "numberInSurah": 35,
      "globalOrder": 5014,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "إِنَّآ أَنشَأْنَـٰهُنَّ إِنشَآءً",
      "translationText": "Biz kadınları yeniden inşa ettik (yarattık).",
      "translationFootnotes": []
    },
    {
      "key": "56:36",
      "surahId": 56,
      "numberInSurah": 36,
      "globalOrder": 5015,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "فَجَعَلْنَـٰهُنَّ أَبْكَارًا",
      "translationText": "Onları bâkireler yaptık.",
      "translationFootnotes": []
    },
    {
      "key": "56:37",
      "surahId": 56,
      "numberInSurah": 37,
      "globalOrder": 5016,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "عُرُبًا أَتْرَابًا",
      "translationText": "Hep yaşıt sevgililer,",
      "translationFootnotes": []
    },
    {
      "key": "56:38",
      "surahId": 56,
      "numberInSurah": 38,
      "globalOrder": 5017,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "لِّأَصْحَـٰبِ ٱلْيَمِينِ",
      "translationText": "Sağın adamları içindir.",
      "translationFootnotes": []
    },
    {
      "key": "56:39",
      "surahId": 56,
      "numberInSurah": 39,
      "globalOrder": 5018,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ",
      "translationText": "Bir çoğu öncekilerdendir.",
      "translationFootnotes": []
    },
    {
      "key": "56:40",
      "surahId": 56,
      "numberInSurah": 40,
      "globalOrder": 5019,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ",
      "translationText": "Bir çoğu da sonrakilerdendir.",
      "translationFootnotes": []
    },
    {
      "key": "56:41",
      "surahId": 56,
      "numberInSurah": 41,
      "globalOrder": 5020,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ",
      "translationText": "Solun adamları, nedir o solcular!",
      "translationFootnotes": []
    },
    {
      "key": "56:42",
      "surahId": 56,
      "numberInSurah": 42,
      "globalOrder": 5021,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "فِى سَمُومٍ وَحَمِيمٍ",
      "translationText": "İçlerine işleyen bir ateş ve kaynar şu içinde,",
      "translationFootnotes": []
    },
    {
      "key": "56:43",
      "surahId": 56,
      "numberInSurah": 43,
      "globalOrder": 5022,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "وَظِلٍّ مِّن يَحْمُومٍ",
      "translationText": "Kapkara dumandan bir gölge altındadırlar.",
      "translationFootnotes": []
    },
    {
      "key": "56:44",
      "surahId": 56,
      "numberInSurah": 44,
      "globalOrder": 5023,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "لَّا بَارِدٍ وَلَا كَرِيمٍ",
      "translationText": "Ki ne serindir, ne de faydalı.",
      "translationFootnotes": []
    },
    {
      "key": "56:45",
      "surahId": 56,
      "numberInSurah": 45,
      "globalOrder": 5024,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ",
      "translationText": "Çünkü onlar bundan önce varlık içinde sefâhete dalmışlardı.",
      "translationFootnotes": []
    },
    {
      "key": "56:46",
      "surahId": 56,
      "numberInSurah": 46,
      "globalOrder": 5025,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ",
      "translationText": "Büyük günahı işlemekte ısrar ediyorlardı.",
      "translationFootnotes": []
    },
    {
      "key": "56:47",
      "surahId": 56,
      "numberInSurah": 47,
      "globalOrder": 5026,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ",
      "translationText": "Ve diyorlardı ki: \"Biz ölüp, toprak ve kemik yığını olduktan sonra, biz mi bir daha diriltileceğiz?\"",
      "translationFootnotes": []
    },
    {
      "key": "56:48",
      "surahId": 56,
      "numberInSurah": 48,
      "globalOrder": 5027,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ",
      "translationText": "\"Önceki atalarımızda mı?\"",
      "translationFootnotes": []
    },
    {
      "key": "56:49",
      "surahId": 56,
      "numberInSurah": 49,
      "globalOrder": 5028,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ",
      "translationText": "De ki: \"Öncekiler ve sonrakiler\"",
      "translationFootnotes": []
    },
    {
      "key": "56:50",
      "surahId": 56,
      "numberInSurah": 50,
      "globalOrder": 5029,
      "pageNumber": 535,
      "juzNumber": 27,
      "arabicText": "لَمَجْمُوعُونَ إِلَىٰ مِيقَـٰتِ يَوْمٍ مَّعْلُومٍ",
      "translationText": "\"Belli bir günün belli vaktinde mutlaka toplanacaklardır.\"",
      "translationFootnotes": []
    },
    {
      "key": "56:51",
      "surahId": 56,
      "numberInSurah": 51,
      "globalOrder": 5030,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ",
      "translationText": "Sonra siz, ey sapık yalanlayıcılar!",
      "translationFootnotes": []
    },
    {
      "key": "56:52",
      "surahId": 56,
      "numberInSurah": 52,
      "globalOrder": 5031,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "لَـَٔاكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ",
      "translationText": "Elbette bir ağaçtan, zakkum ağacından yiyeceksiniz.",
      "translationFootnotes": []
    },
    {
      "key": "56:53",
      "surahId": 56,
      "numberInSurah": 53,
      "globalOrder": 5032,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ",
      "translationText": "Karınlarınızı hep onunla dolduracaksınız.",
      "translationFootnotes": []
    },
    {
      "key": "56:54",
      "surahId": 56,
      "numberInSurah": 54,
      "globalOrder": 5033,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "فَشَـٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ",
      "translationText": "Üstüne de kaynar su içeceksiniz.",
      "translationFootnotes": []
    },
    {
      "key": "56:55",
      "surahId": 56,
      "numberInSurah": 55,
      "globalOrder": 5034,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "فَشَـٰرِبُونَ شُرْبَ ٱلْهِيمِ",
      "translationText": "Susuzluk illetine tutulmuş develerin içişi gibi içeceksiniz.",
      "translationFootnotes": []
    },
    {
      "key": "56:56",
      "surahId": 56,
      "numberInSurah": 56,
      "globalOrder": 5035,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "هَـٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ",
      "translationText": "İşte ceza gününde onlara sunulacak ziyafet budur.",
      "translationFootnotes": []
    },
    {
      "key": "56:57",
      "surahId": 56,
      "numberInSurah": 57,
      "globalOrder": 5036,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "نَحْنُ خَلَقْنَـٰكُمْ فَلَوْلَا تُصَدِّقُونَ",
      "translationText": "Biz sizi yarattık; tasdik etmeniz gerekmez mi?",
      "translationFootnotes": []
    },
    {
      "key": "56:58",
      "surahId": 56,
      "numberInSurah": 58,
      "globalOrder": 5037,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "أَفَرَءَيْتُم مَّا تُمْنُونَ",
      "translationText": "Attığınız meniyi gördünüz mü?",
      "translationFootnotes": []
    },
    {
      "key": "56:59",
      "surahId": 56,
      "numberInSurah": 59,
      "globalOrder": 5038,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَـٰلِقُونَ",
      "translationText": "Onu siz mi yaratıyorsunuz yoksa yaratan biz miyiz?",
      "translationFootnotes": []
    },
    {
      "key": "56:60",
      "surahId": 56,
      "numberInSurah": 60,
      "globalOrder": 5039,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ",
      "translationText": "Aranızda ölümü takdir eden biziz ve bizim önümüze geçilmez.",
      "translationFootnotes": []
    },
    {
      "key": "56:61",
      "surahId": 56,
      "numberInSurah": 61,
      "globalOrder": 5040,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَـٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ",
      "translationText": "Böylece sizin yerinize benzerlerinizi getirelim ve sizi bilmediğiniz bir yaratılışta tekrar var edelim diye (böyle yapıyoruz).",
      "translationFootnotes": []
    },
    {
      "key": "56:62",
      "surahId": 56,
      "numberInSurah": 62,
      "globalOrder": 5041,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ",
      "translationText": "Andolsun, ilk yaratılışı bildiniz. Düşünüp ibret almanız gerekmez mi?",
      "translationFootnotes": []
    },
    {
      "key": "56:63",
      "surahId": 56,
      "numberInSurah": 63,
      "globalOrder": 5042,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ",
      "translationText": "Ektiğinizi gördünüz mü?",
      "translationFootnotes": []
    },
    {
      "key": "56:64",
      "surahId": 56,
      "numberInSurah": 64,
      "globalOrder": 5043,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ",
      "translationText": "Onu siz mi bitiriyorsunuz, yoksa bitiren biz miyiz?",
      "translationFootnotes": []
    },
    {
      "key": "56:65",
      "surahId": 56,
      "numberInSurah": 65,
      "globalOrder": 5044,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًا فَظَلْتُمْ تَفَكَّهُونَ",
      "translationText": "Dileseydik, onu kuru bir çöp yapardık. Hayret eder dururdunuz.",
      "translationFootnotes": []
    },
    {
      "key": "56:66",
      "surahId": 56,
      "numberInSurah": 66,
      "globalOrder": 5045,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "إِنَّا لَمُغْرَمُونَ",
      "translationText": "\"Doğrusu borç altına girdik.\"",
      "translationFootnotes": []
    },
    {
      "key": "56:67",
      "surahId": 56,
      "numberInSurah": 67,
      "globalOrder": 5046,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "بَلْ نَحْنُ مَحْرُومُونَ",
      "translationText": "\"Doğrusu, biz yoksul bırakıldık\" (derdiniz).",
      "translationFootnotes": []
    },
    {
      "key": "56:68",
      "surahId": 56,
      "numberInSurah": 68,
      "globalOrder": 5047,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ",
      "translationText": "İçtiğiniz suya baktınız mı?",
      "translationFootnotes": []
    },
    {
      "key": "56:69",
      "surahId": 56,
      "numberInSurah": 69,
      "globalOrder": 5048,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ",
      "translationText": "Buluttan onu siz mi indirdiniz, yoksa indiren biz miyiz?",
      "translationFootnotes": []
    },
    {
      "key": "56:70",
      "surahId": 56,
      "numberInSurah": 70,
      "globalOrder": 5049,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "لَوْ نَشَآءُ جَعَلْنَـٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ",
      "translationText": "Dileseydik onu tuzlu yapardık. O halde şükretseniz ya!",
      "translationFootnotes": []
    },
    {
      "key": "56:71",
      "surahId": 56,
      "numberInSurah": 71,
      "globalOrder": 5050,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ",
      "translationText": "Yaktığınız ateşi gördünüz mü?",
      "translationFootnotes": []
    },
    {
      "key": "56:72",
      "surahId": 56,
      "numberInSurah": 72,
      "globalOrder": 5051,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ",
      "translationText": "Onun ağacını siz mi yarattınız, yoksa yaratan biz miyiz?",
      "translationFootnotes": []
    },
    {
      "key": "56:73",
      "surahId": 56,
      "numberInSurah": 73,
      "globalOrder": 5052,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "نَحْنُ جَعَلْنَـٰهَا تَذْكِرَةً وَمَتَـٰعًا لِّلْمُقْوِينَ",
      "translationText": "Biz onu bir ibret ve çölden gelip geçenlere bir fayda yaptık.",
      "translationFootnotes": []
    },
    {
      "key": "56:74",
      "surahId": 56,
      "numberInSurah": 74,
      "globalOrder": 5053,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
      "translationText": "Öyleyse büyük Rabbinin adını yücelt.",
      "translationFootnotes": []
    },
    {
      "key": "56:75",
      "surahId": 56,
      "numberInSurah": 75,
      "globalOrder": 5054,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ",
      "translationText": "Hayır, yıldızların yerlerine yemin ederim.",
      "translationFootnotes": []
    },
    {
      "key": "56:76",
      "surahId": 56,
      "numberInSurah": 76,
      "globalOrder": 5055,
      "pageNumber": 536,
      "juzNumber": 27,
      "arabicText": "وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ",
      "translationText": "Bilirseniz bu büyük bir yemindir.",
      "translationFootnotes": []
    },
    {
      "key": "56:77",
      "surahId": 56,
      "numberInSurah": 77,
      "globalOrder": 5056,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "إِنَّهُۥ لَقُرْءَانٌ كَرِيمٌ",
      "translationText": "O, elbette şerefli bir Kur'ân'dır.",
      "translationFootnotes": []
    },
    {
      "key": "56:78",
      "surahId": 56,
      "numberInSurah": 78,
      "globalOrder": 5057,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "فِى كِتَـٰبٍ مَّكْنُونٍ",
      "translationText": "Korunmuş bir kitaptadır.",
      "translationFootnotes": []
    },
    {
      "key": "56:79",
      "surahId": 56,
      "numberInSurah": 79,
      "globalOrder": 5058,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ",
      "translationText": "Ona temizlenenlerden başkası el süremez.",
      "translationFootnotes": []
    },
    {
      "key": "56:80",
      "surahId": 56,
      "numberInSurah": 80,
      "globalOrder": 5059,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ",
      "translationText": "(O), âlemlerin Rabbinden indirilmiştir.",
      "translationFootnotes": []
    },
    {
      "key": "56:81",
      "surahId": 56,
      "numberInSurah": 81,
      "globalOrder": 5060,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ",
      "translationText": "Şimdi siz bu sözü mü küçümsüyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "56:82",
      "surahId": 56,
      "numberInSurah": 82,
      "globalOrder": 5061,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ",
      "translationText": "Rızkınızı, yalanlamanızdan ibaret mi kılıyorsunuz?",
      "translationFootnotes": []
    },
    {
      "key": "56:83",
      "surahId": 56,
      "numberInSurah": 83,
      "globalOrder": 5062,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ",
      "translationText": "Can boğaza dayandığı zaman",
      "translationFootnotes": []
    },
    {
      "key": "56:84",
      "surahId": 56,
      "numberInSurah": 84,
      "globalOrder": 5063,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ",
      "translationText": "Ki o zaman siz (ölmek üzere olana) bakar durursunuz.",
      "translationFootnotes": []
    },
    {
      "key": "56:85",
      "surahId": 56,
      "numberInSurah": 85,
      "globalOrder": 5064,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَـٰكِن لَّا تُبْصِرُونَ",
      "translationText": "Biz ona sizden daha yakınız, fakat siz görmezsiniz.",
      "translationFootnotes": []
    },
    {
      "key": "56:86",
      "surahId": 56,
      "numberInSurah": 86,
      "globalOrder": 5065,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ",
      "translationText": "Eğer cezalandırılmayacak iseniz,",
      "translationFootnotes": []
    },
    {
      "key": "56:87",
      "surahId": 56,
      "numberInSurah": 87,
      "globalOrder": 5066,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "تَرْجِعُونَهَآ إِن كُنتُمْ صَـٰدِقِينَ",
      "translationText": "Onu geri çevirsenize; şayet iddianızda doğru iseniz.",
      "translationFootnotes": []
    },
    {
      "key": "56:88",
      "surahId": 56,
      "numberInSurah": 88,
      "globalOrder": 5067,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ",
      "translationText": "Fakat ölen kişiye gelince, eğer o rahmete yaklaştırılanlardan ise,",
      "translationFootnotes": []
    },
    {
      "key": "56:89",
      "surahId": 56,
      "numberInSurah": 89,
      "globalOrder": 5068,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ",
      "translationText": "Ona rahatlık, güzel rızık ve Naîm cenneti vardır.",
      "translationFootnotes": []
    },
    {
      "key": "56:90",
      "surahId": 56,
      "numberInSurah": 90,
      "globalOrder": 5069,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "وَأَمَّآ إِن كَانَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ",
      "translationText": "Eğer O, sağın adamlarından ise,",
      "translationFootnotes": []
    },
    {
      "key": "56:91",
      "surahId": 56,
      "numberInSurah": 91,
      "globalOrder": 5070,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "فَسَلَـٰمٌ لَّكَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ",
      "translationText": "\"(Ey sağcı), sana sağcılardan selam!\"",
      "translationFootnotes": []
    },
    {
      "key": "56:92",
      "surahId": 56,
      "numberInSurah": 92,
      "globalOrder": 5071,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ",
      "translationText": "Ama yalanlayıcı sapıklardan ise;",
      "translationFootnotes": []
    },
    {
      "key": "56:93",
      "surahId": 56,
      "numberInSurah": 93,
      "globalOrder": 5072,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "فَنُزُلٌ مِّنْ حَمِيمٍ",
      "translationText": "İşte ona da kaynar sudan bir ziyafet vardır.",
      "translationFootnotes": []
    },
    {
      "key": "56:94",
      "surahId": 56,
      "numberInSurah": 94,
      "globalOrder": 5073,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "وَتَصْلِيَةُ جَحِيمٍ",
      "translationText": "Ve cehenneme atılma vardır.",
      "translationFootnotes": []
    },
    {
      "key": "56:95",
      "surahId": 56,
      "numberInSurah": 95,
      "globalOrder": 5074,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "إِنَّ هَـٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ",
      "translationText": "Kesin gerçek budur işte.",
      "translationFootnotes": []
    },
    {
      "key": "56:96",
      "surahId": 56,
      "numberInSurah": 96,
      "globalOrder": 5075,
      "pageNumber": 537,
      "juzNumber": 27,
      "arabicText": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
      "translationText": "Öyle ise Rabbini o büyük ismiyle tesbih et.",
      "translationFootnotes": []
    }
  ]
}

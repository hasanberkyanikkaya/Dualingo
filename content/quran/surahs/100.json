{
  "schemaVersion": 1,
  "surah": {
    "id": 100,
    "nameArabic": "العاديات",
    "nameTurkish": "Âdiyât Sûresi",
    "verseCount": 11,
    "firstGlobalOrder": 6147
  },
  "verses": [
    {
      "key": "100:1",
      "surahId": 100,
      "numberInSurah": 1,
      "globalOrder": 6147,
      "pageNumber": 599,
      "juzNumber": 30,
      "arabicText": "وَٱلْعَـٰدِيَـٰتِ ضَبْحًا",
      "translationText": "O harıl harıl (savaşa) koşanlara,",
      "translationFootnotes": []
    },
    {
      "key": "100:2",
      "surahId": 100,
      "numberInSurah": 2,
      "globalOrder": 6148,
      "pageNumber": 599,
      "juzNumber": 30,
      "arabicText": "فَٱلْمُورِيَـٰتِ قَدْحًا",
      "translationText": "(Tırnaklarıyla yerden) ateş çıkaranlara,",
      "translationFootnotes": []
    },
    {
      "key": "100:3",
      "surahId": 100,
      "numberInSurah": 3,
      "globalOrder": 6149,
      "pageNumber": 599,
      "juzNumber": 30,
      "arabicText": "فَٱلْمُغِيرَٰتِ صُبْحًا",
      "translationText": "Sabahleyin akın edenlere,",
      "translationFootnotes": []
    },
    {
      "key": "100:4",
      "surahId": 100,
      "numberInSurah": 4,
      "globalOrder": 6150,
      "pageNumber": 599,
      "juzNumber": 30,
      "arabicText": "فَأَثَرْنَ بِهِۦ نَقْعًا",
      "translationText": "Tozu dumana karıştıranlara,",
      "translationFootnotes": []
    },
    {
      "key": "100:5",
      "surahId": 100,
      "numberInSurah": 5,
      "globalOrder": 6151,
      "pageNumber": 599,
      "juzNumber": 30,
      "arabicText": "فَوَسَطْنَ بِهِۦ جَمْعًا",
      "translationText": "Derken bir topluluğun ortasına dalanlara yemin ederim ki,",
      "translationFootnotes": []
    },
    {
      "key": "100:6",
      "surahId": 100,
      "numberInSurah": 6,
      "globalOrder": 6152,
      "pageNumber": 599,
      "juzNumber": 30,
      "arabicText": "إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ",
      "translationText": "Şüphesiz insan, Rabbine karşı çok nankördür.",
      "translationFootnotes": []
    },
    {
      "key": "100:7",
      "surahId": 100,
      "numberInSurah": 7,
      "globalOrder": 6153,
      "pageNumber": 599,
      "juzNumber": 30,
      "arabicText": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ",
      "translationText": "Ve kendisi de buna şahittir.",
      "translationFootnotes": []
    },
    {
      "key": "100:8",
      "surahId": 100,
      "numberInSurah": 8,
      "globalOrder": 6154,
      "pageNumber": 599,
      "juzNumber": 30,
      "arabicText": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",
      "translationText": "Gerçekten o dünya malını çok sevdiği için katıdır.",
      "translationFootnotes": []
    },
    {
      "key": "100:9",
      "surahId": 100,
      "numberInSurah": 9,
      "globalOrder": 6155,
      "pageNumber": 599,
      "juzNumber": 30,
      "arabicText": "أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ",
      "translationText": "Bilmiyor mu ki, kabirlerin içindekiler fırlatılacak.",
      "translationFootnotes": []
    },
    {
      "key": "100:10",
      "surahId": 100,
      "numberInSurah": 10,
      "globalOrder": 6156,
      "pageNumber": 600,
      "juzNumber": 30,
      "arabicText": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ",
      "translationText": "Ve sinelerin içindekiler derlenecek.",
      "translationFootnotes": []
    },
    {
      "key": "100:11",
      "surahId": 100,
      "numberInSurah": 11,
      "globalOrder": 6157,
      "pageNumber": 600,
      "juzNumber": 30,
      "arabicText": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ",
      "translationText": "O gün Rableri onların bütün yaptıklarından haberdardır",
      "translationFootnotes": []
    }
  ]
}

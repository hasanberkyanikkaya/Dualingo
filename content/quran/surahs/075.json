{
  "schemaVersion": 1,
  "surah": {
    "id": 75,
    "nameArabic": "القيامة",
    "nameTurkish": null,
    "verseCount": 40,
    "firstGlobalOrder": 5552
  },
  "verses": [
    {
      "key": "75:1",
      "surahId": 75,
      "numberInSurah": 1,
      "globalOrder": 5552,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ",
      "translationText": "Hayır, yemin ederim o kıyamet gününe.",
      "translationFootnotes": []
    },
    {
      "key": "75:2",
      "surahId": 75,
      "numberInSurah": 2,
      "globalOrder": 5553,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ",
      "translationText": "Yine hayır, yemin ederim o sürekli kendini kınayan nefse.",
      "translationFootnotes": []
    },
    {
      "key": "75:3",
      "surahId": 75,
      "numberInSurah": 3,
      "globalOrder": 5554,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
      "translationText": "İnsan, kendisinin kemiklerini bir araya toplayamayacağımızı mı sanıyor?",
      "translationFootnotes": []
    },
    {
      "key": "75:4",
      "surahId": 75,
      "numberInSurah": 4,
      "globalOrder": 5555,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ",
      "translationText": "Evet, bizim onun parmak uçlarını bile aynen eski haline getirmeye gücümüz yeter.",
      "translationFootnotes": []
    },
    {
      "key": "75:5",
      "surahId": 75,
      "numberInSurah": 5,
      "globalOrder": 5556,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ",
      "translationText": "Fakat insan günahı devam ettirmek ister.",
      "translationFootnotes": []
    },
    {
      "key": "75:6",
      "surahId": 75,
      "numberInSurah": 6,
      "globalOrder": 5557,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ",
      "translationText": "O kıyamet günü ne zaman? diye sorar.",
      "translationFootnotes": []
    },
    {
      "key": "75:7",
      "surahId": 75,
      "numberInSurah": 7,
      "globalOrder": 5558,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "فَإِذَا بَرِقَ ٱلْبَصَرُ",
      "translationText": "Ne zaman ki o göz şimşek çakar,",
      "translationFootnotes": []
    },
    {
      "key": "75:8",
      "surahId": 75,
      "numberInSurah": 8,
      "globalOrder": 5559,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "وَخَسَفَ ٱلْقَمَرُ",
      "translationText": "Ay tutulur,",
      "translationFootnotes": []
    },
    {
      "key": "75:9",
      "surahId": 75,
      "numberInSurah": 9,
      "globalOrder": 5560,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ",
      "translationText": "Güneş ve ay toplanır,",
      "translationFootnotes": []
    },
    {
      "key": "75:10",
      "surahId": 75,
      "numberInSurah": 10,
      "globalOrder": 5561,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ",
      "translationText": "İşte o gün insan, \"kaçacak yer neresi?\" der.",
      "translationFootnotes": []
    },
    {
      "key": "75:11",
      "surahId": 75,
      "numberInSurah": 11,
      "globalOrder": 5562,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "كَلَّا لَا وَزَرَ",
      "translationText": "Hayır, hayır, yok bir siper.",
      "translationFootnotes": []
    },
    {
      "key": "75:12",
      "surahId": 75,
      "numberInSurah": 12,
      "globalOrder": 5563,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ",
      "translationText": "O gün varılıp durulacak yer, ancak Rabbinin huzurudur.",
      "translationFootnotes": []
    },
    {
      "key": "75:13",
      "surahId": 75,
      "numberInSurah": 13,
      "globalOrder": 5564,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ",
      "translationText": "O gün insana, yapıp öne sürdüğü ve geri bıraktığı ne varsa bildirilir.",
      "translationFootnotes": []
    },
    {
      "key": "75:14",
      "surahId": 75,
      "numberInSurah": 14,
      "globalOrder": 5565,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ",
      "translationText": "Doğrusu insan kendi nefsini görür,",
      "translationFootnotes": []
    },
    {
      "key": "75:15",
      "surahId": 75,
      "numberInSurah": 15,
      "globalOrder": 5566,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ",
      "translationText": "Bir takım özürler ortaya atsa da.",
      "translationFootnotes": []
    },
    {
      "key": "75:16",
      "surahId": 75,
      "numberInSurah": 16,
      "globalOrder": 5567,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
      "translationText": "Onu hemen okumak için dilini depretme.",
      "translationFootnotes": []
    },
    {
      "key": "75:17",
      "surahId": 75,
      "numberInSurah": 17,
      "globalOrder": 5568,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
      "translationText": "Kuşkusuz onu toplamak ve okumak bize aittir.",
      "translationFootnotes": []
    },
    {
      "key": "75:18",
      "surahId": 75,
      "numberInSurah": 18,
      "globalOrder": 5569,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
      "translationText": "O halde biz onu okuduğumuz zaman sen onun okunuşunu takip et.",
      "translationFootnotes": []
    },
    {
      "key": "75:19",
      "surahId": 75,
      "numberInSurah": 19,
      "globalOrder": 5570,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ",
      "translationText": "Sonra onu açıklamak da bize aittir.",
      "translationFootnotes": []
    },
    {
      "key": "75:20",
      "surahId": 75,
      "numberInSurah": 20,
      "globalOrder": 5571,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ",
      "translationText": "Hayır, siz peşin olanı (dünyayı) seviyorsunuz da",
      "translationFootnotes": []
    },
    {
      "key": "75:21",
      "surahId": 75,
      "numberInSurah": 21,
      "globalOrder": 5572,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "وَتَذَرُونَ ٱلْـَٔاخِرَةَ",
      "translationText": "Ahireti bırakıyorsunuz.",
      "translationFootnotes": []
    },
    {
      "key": "75:22",
      "surahId": 75,
      "numberInSurah": 22,
      "globalOrder": 5573,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ",
      "translationText": "Yüzler var ki o gün ışıl ışıl parlar.",
      "translationFootnotes": []
    },
    {
      "key": "75:23",
      "surahId": 75,
      "numberInSurah": 23,
      "globalOrder": 5574,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "إِلَىٰ رَبِّهَا نَاظِرَةٌ",
      "translationText": "Rabbine bakar.",
      "translationFootnotes": []
    },
    {
      "key": "75:24",
      "surahId": 75,
      "numberInSurah": 24,
      "globalOrder": 5575,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ",
      "translationText": "Yüzler de var ki o gün asıktır.",
      "translationFootnotes": []
    },
    {
      "key": "75:25",
      "surahId": 75,
      "numberInSurah": 25,
      "globalOrder": 5576,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ",
      "translationText": "Anlar ki kendisine belkıran (bel kemiklerini kıran belalı bir iş) yapılır.",
      "translationFootnotes": []
    },
    {
      "key": "75:26",
      "surahId": 75,
      "numberInSurah": 26,
      "globalOrder": 5577,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ",
      "translationText": "Hayır hayır, ne zaman ki can köprücük kemiklerine dayanır,",
      "translationFootnotes": []
    },
    {
      "key": "75:27",
      "surahId": 75,
      "numberInSurah": 27,
      "globalOrder": 5578,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "وَقِيلَ مَنْ ۜ رَاقٍ",
      "translationText": "\"Tedavi edebilecek kimdir?\" denilir.",
      "translationFootnotes": []
    },
    {
      "key": "75:28",
      "surahId": 75,
      "numberInSurah": 28,
      "globalOrder": 5579,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ",
      "translationText": "Can çekişen bunun o ayrılık anı olduğunu anlar.",
      "translationFootnotes": []
    },
    {
      "key": "75:29",
      "surahId": 75,
      "numberInSurah": 29,
      "globalOrder": 5580,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ",
      "translationText": "Bacak bacağa dolaşır..",
      "translationFootnotes": []
    },
    {
      "key": "75:30",
      "surahId": 75,
      "numberInSurah": 30,
      "globalOrder": 5581,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ",
      "translationText": "İşte o gün sevk, ancak Rabbinedir.",
      "translationFootnotes": []
    },
    {
      "key": "75:31",
      "surahId": 75,
      "numberInSurah": 31,
      "globalOrder": 5582,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "فَلَا صَدَّقَ وَلَا صَلَّىٰ",
      "translationText": "Fakat o, ne sadaka verdi, ne namaz kıldı.",
      "translationFootnotes": []
    },
    {
      "key": "75:32",
      "surahId": 75,
      "numberInSurah": 32,
      "globalOrder": 5583,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ",
      "translationText": "Fakat yalanladı ve döndü.",
      "translationFootnotes": []
    },
    {
      "key": "75:33",
      "surahId": 75,
      "numberInSurah": 33,
      "globalOrder": 5584,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ",
      "translationText": "Sonra da çalım sata sata ailesine gitti.",
      "translationFootnotes": []
    },
    {
      "key": "75:34",
      "surahId": 75,
      "numberInSurah": 34,
      "globalOrder": 5585,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "أَوْلَىٰ لَكَ فَأَوْلَىٰ",
      "translationText": "Gerektir o bela sana, gerek.",
      "translationFootnotes": []
    },
    {
      "key": "75:35",
      "surahId": 75,
      "numberInSurah": 35,
      "globalOrder": 5586,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ",
      "translationText": "Evet, gerektir o bela sana gerek.",
      "translationFootnotes": []
    },
    {
      "key": "75:36",
      "surahId": 75,
      "numberInSurah": 36,
      "globalOrder": 5587,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى",
      "translationText": "İnsan başıboş bırakılacağını mı sanır?",
      "translationFootnotes": []
    },
    {
      "key": "75:37",
      "surahId": 75,
      "numberInSurah": 37,
      "globalOrder": 5588,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ",
      "translationText": "O, dökülen erlik suyundan bir damla (sperm) değil miydi?",
      "translationFootnotes": []
    },
    {
      "key": "75:38",
      "surahId": 75,
      "numberInSurah": 38,
      "globalOrder": 5589,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ",
      "translationText": "Sonra bir aleka (embriyon) oldu da Rabbi onu biçime koydu, sonra şekil verdi.",
      "translationFootnotes": []
    },
    {
      "key": "75:39",
      "surahId": 75,
      "numberInSurah": 39,
      "globalOrder": 5590,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "translationText": "Ondan da iki cinsi; erkek ve dişiyi var etti.",
      "translationFootnotes": []
    },
    {
      "key": "75:40",
      "surahId": 75,
      "numberInSurah": 40,
      "globalOrder": 5591,
      "pageNumber": 578,
      "juzNumber": 29,
      "arabicText": "أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ",
      "translationText": "Peki, bunu yapanın ölüleri diriltmeye gücü yetmez mi?",
      "translationFootnotes": []
    }
  ]
}

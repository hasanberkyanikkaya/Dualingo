{
  "schemaVersion": 1,
  "surah": {
    "id": 74,
    "nameArabic": "المدثر",
    "nameTurkish": null,
    "verseCount": 56,
    "firstGlobalOrder": 5496
  },
  "verses": [
    {
      "key": "74:1",
      "surahId": 74,
      "numberInSurah": 1,
      "globalOrder": 5496,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "يَـٰٓأَيُّهَا ٱلْمُدَّثِّرُ",
      "translationText": "Ey örtüsüne bürünen (Peygamber)!",
      "translationFootnotes": []
    },
    {
      "key": "74:2",
      "surahId": 74,
      "numberInSurah": 2,
      "globalOrder": 5497,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "قُمْ فَأَنذِرْ",
      "translationText": "Kalk artık uyar.",
      "translationFootnotes": []
    },
    {
      "key": "74:3",
      "surahId": 74,
      "numberInSurah": 3,
      "globalOrder": 5498,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "وَرَبَّكَ فَكَبِّرْ",
      "translationText": "Sadece Rabbini yücelt.",
      "translationFootnotes": []
    },
    {
      "key": "74:4",
      "surahId": 74,
      "numberInSurah": 4,
      "globalOrder": 5499,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "وَثِيَابَكَ فَطَهِّرْ",
      "translationText": "Elbiseni temizle.",
      "translationFootnotes": []
    },
    {
      "key": "74:5",
      "surahId": 74,
      "numberInSurah": 5,
      "globalOrder": 5500,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "وَٱلرُّجْزَ فَٱهْجُرْ",
      "translationText": "Pislikten sakın.",
      "translationFootnotes": []
    },
    {
      "key": "74:6",
      "surahId": 74,
      "numberInSurah": 6,
      "globalOrder": 5501,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "وَلَا تَمْنُن تَسْتَكْثِرُ",
      "translationText": "Yaptığını çok görerek başa kakma.",
      "translationFootnotes": []
    },
    {
      "key": "74:7",
      "surahId": 74,
      "numberInSurah": 7,
      "globalOrder": 5502,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "وَلِرَبِّكَ فَٱصْبِرْ",
      "translationText": "Rabbin için sabret.",
      "translationFootnotes": []
    },
    {
      "key": "74:8",
      "surahId": 74,
      "numberInSurah": 8,
      "globalOrder": 5503,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ",
      "translationText": "O sûra üflendiği zaman,",
      "translationFootnotes": []
    },
    {
      "key": "74:9",
      "surahId": 74,
      "numberInSurah": 9,
      "globalOrder": 5504,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "فَذَٰلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ",
      "translationText": "İşte o gün pek zorlu bir gündür.",
      "translationFootnotes": []
    },
    {
      "key": "74:10",
      "surahId": 74,
      "numberInSurah": 10,
      "globalOrder": 5505,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "عَلَى ٱلْكَـٰفِرِينَ غَيْرُ يَسِيرٍ",
      "translationText": "Kâfirler için hiç kolay değildir.",
      "translationFootnotes": []
    },
    {
      "key": "74:11",
      "surahId": 74,
      "numberInSurah": 11,
      "globalOrder": 5506,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًا",
      "translationText": "Tek olarak yarattığım o kimseyi bana bırak.",
      "translationFootnotes": []
    },
    {
      "key": "74:12",
      "surahId": 74,
      "numberInSurah": 12,
      "globalOrder": 5507,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "وَجَعَلْتُ لَهُۥ مَالًا مَّمْدُودًا",
      "translationText": "Hem ona bol servet verdim.",
      "translationFootnotes": []
    },
    {
      "key": "74:13",
      "surahId": 74,
      "numberInSurah": 13,
      "globalOrder": 5508,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "وَبَنِينَ شُهُودًا",
      "translationText": "Hem göz önünde oğullar verdim.",
      "translationFootnotes": []
    },
    {
      "key": "74:14",
      "surahId": 74,
      "numberInSurah": 14,
      "globalOrder": 5509,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "وَمَهَّدتُّ لَهُۥ تَمْهِيدًا",
      "translationText": "Hem ona büyük imkânlar sağladım.",
      "translationFootnotes": []
    },
    {
      "key": "74:15",
      "surahId": 74,
      "numberInSurah": 15,
      "globalOrder": 5510,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "ثُمَّ يَطْمَعُ أَنْ أَزِيدَ",
      "translationText": "Sonra da şiddetle arzu eder ki daha da artırayım.",
      "translationFootnotes": []
    },
    {
      "key": "74:16",
      "surahId": 74,
      "numberInSurah": 16,
      "globalOrder": 5511,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "كَلَّآ ۖ إِنَّهُۥ كَانَ لِـَٔايَـٰتِنَا عَنِيدًا",
      "translationText": "Hayır, çünkü o bizim âyetlerimize karşı bir inatçı kesildi.",
      "translationFootnotes": []
    },
    {
      "key": "74:17",
      "surahId": 74,
      "numberInSurah": 17,
      "globalOrder": 5512,
      "pageNumber": 575,
      "juzNumber": 29,
      "arabicText": "سَأُرْهِقُهُۥ صَعُودًا",
      "translationText": "Ben onu dimdik bir yokuşa sardıracağım.",
      "translationFootnotes": []
    },
    {
      "key": "74:18",
      "surahId": 74,
      "numberInSurah": 18,
      "globalOrder": 5513,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "إِنَّهُۥ فَكَّرَ وَقَدَّرَ",
      "translationText": "Çünkü o bir düşündü, ölçtü, biçti.",
      "translationFootnotes": []
    },
    {
      "key": "74:19",
      "surahId": 74,
      "numberInSurah": 19,
      "globalOrder": 5514,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "فَقُتِلَ كَيْفَ قَدَّرَ",
      "translationText": "Kahrolası nasıl da ölçtü, biçti.",
      "translationFootnotes": []
    },
    {
      "key": "74:20",
      "surahId": 74,
      "numberInSurah": 20,
      "globalOrder": 5515,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "ثُمَّ قُتِلَ كَيْفَ قَدَّرَ",
      "translationText": "Yine kahrolası, nasıl ölçtü biçti.",
      "translationFootnotes": []
    },
    {
      "key": "74:21",
      "surahId": 74,
      "numberInSurah": 21,
      "globalOrder": 5516,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "ثُمَّ نَظَرَ",
      "translationText": "Sonra baktı.",
      "translationFootnotes": []
    },
    {
      "key": "74:22",
      "surahId": 74,
      "numberInSurah": 22,
      "globalOrder": 5517,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "ثُمَّ عَبَسَ وَبَسَرَ",
      "translationText": "Sonra kaşını çattı, surat astı.",
      "translationFootnotes": []
    },
    {
      "key": "74:23",
      "surahId": 74,
      "numberInSurah": 23,
      "globalOrder": 5518,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ",
      "translationText": "Sonra arkasını döndü ve büyüklük tasladı.",
      "translationFootnotes": []
    },
    {
      "key": "74:24",
      "surahId": 74,
      "numberInSurah": 24,
      "globalOrder": 5519,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "فَقَالَ إِنْ هَـٰذَآ إِلَّا سِحْرٌ يُؤْثَرُ",
      "translationText": "\"Bu, dedi, başka değil öğretilegelen bir sihirdir.\"",
      "translationFootnotes": []
    },
    {
      "key": "74:25",
      "surahId": 74,
      "numberInSurah": 25,
      "globalOrder": 5520,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "إِنْ هَـٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ",
      "translationText": "\"Bu, sadece bir insan sözüdür.\"",
      "translationFootnotes": []
    },
    {
      "key": "74:26",
      "surahId": 74,
      "numberInSurah": 26,
      "globalOrder": 5521,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "سَأُصْلِيهِ سَقَرَ",
      "translationText": "Ben onu Sekar'a (cehenneme) sokacağım.",
      "translationFootnotes": []
    },
    {
      "key": "74:27",
      "surahId": 74,
      "numberInSurah": 27,
      "globalOrder": 5522,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "وَمَآ أَدْرَىٰكَ مَا سَقَرُ",
      "translationText": "Bilir misin sen, nedir o sekar?",
      "translationFootnotes": []
    },
    {
      "key": "74:28",
      "surahId": 74,
      "numberInSurah": 28,
      "globalOrder": 5523,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "لَا تُبْقِى وَلَا تَذَرُ",
      "translationText": "Ne geriye bir şey kor, ne bırakır.",
      "translationFootnotes": []
    },
    {
      "key": "74:29",
      "surahId": 74,
      "numberInSurah": 29,
      "globalOrder": 5524,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "لَوَّاحَةٌ لِّلْبَشَرِ",
      "translationText": "Durmadan derileri kavurur.",
      "translationFootnotes": []
    },
    {
      "key": "74:30",
      "surahId": 74,
      "numberInSurah": 30,
      "globalOrder": 5525,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "عَلَيْهَا تِسْعَةَ عَشَرَ",
      "translationText": "Üzerinde ondokuz (melek) vardır.",
      "translationFootnotes": []
    },
    {
      "key": "74:31",
      "surahId": 74,
      "numberInSurah": 31,
      "globalOrder": 5526,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "وَمَا جَعَلْنَآ أَصْحَـٰبَ ٱلنَّارِ إِلَّا مَلَـٰٓئِكَةً ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةً لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَـٰنًا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ وَٱلْكَـٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَـٰذَا مَثَلًا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ",
      "translationText": "Biz o ateşin muhafızlarını hep melekler yaptık. Bunların sayılarını da ancak kâfirler için bir imtihan kıldık ki, kendilerine kitap verilenler kesin bilgi edinsinler, iman edenlerin de imanı artsın. Kendilerine kitap verilenler ve müminler şüpheye düşmesinler. Kalplerinde hastalık bulunanlarla kâfirler de: \"Allah bu misalle ne demek istedi?\" desinler. İşte böyle, Allah dilediğini şaşırtır, dilediğini de yola getirir. Rabbinin ordularını ancak Rabbin bilir. Bu, insanlar için uyarıdan başka bir şey değildir.",
      "translationFootnotes": []
    },
    {
      "key": "74:32",
      "surahId": 74,
      "numberInSurah": 32,
      "globalOrder": 5527,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "كَلَّا وَٱلْقَمَرِ",
      "translationText": "Hayır, andolsun aya,",
      "translationFootnotes": []
    },
    {
      "key": "74:33",
      "surahId": 74,
      "numberInSurah": 33,
      "globalOrder": 5528,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "وَٱلَّيْلِ إِذْ أَدْبَرَ",
      "translationText": "Döndüğü an o geceye,",
      "translationFootnotes": []
    },
    {
      "key": "74:34",
      "surahId": 74,
      "numberInSurah": 34,
      "globalOrder": 5529,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "وَٱلصُّبْحِ إِذَآ أَسْفَرَ",
      "translationText": "Ve açtığı sıra o sabaha.",
      "translationFootnotes": []
    },
    {
      "key": "74:35",
      "surahId": 74,
      "numberInSurah": 35,
      "globalOrder": 5530,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "إِنَّهَا لَإِحْدَى ٱلْكُبَرِ",
      "translationText": "Kuşkusuz o Sekar, büyük belalardan biridir.",
      "translationFootnotes": []
    },
    {
      "key": "74:36",
      "surahId": 74,
      "numberInSurah": 36,
      "globalOrder": 5531,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "نَذِيرًا لِّلْبَشَرِ",
      "translationText": "Uyarmak için insanları..",
      "translationFootnotes": []
    },
    {
      "key": "74:37",
      "surahId": 74,
      "numberInSurah": 37,
      "globalOrder": 5532,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ",
      "translationText": "İçinizden ileri gitmek veya geri kalmak isteyen kimseleri..",
      "translationFootnotes": []
    },
    {
      "key": "74:38",
      "surahId": 74,
      "numberInSurah": 38,
      "globalOrder": 5533,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ",
      "translationText": "Her nefis kendi kazancına bağlıdır.",
      "translationFootnotes": []
    },
    {
      "key": "74:39",
      "surahId": 74,
      "numberInSurah": 39,
      "globalOrder": 5534,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "إِلَّآ أَصْحَـٰبَ ٱلْيَمِينِ",
      "translationText": "Ancak amel defterleri sağından verilenler hariç.",
      "translationFootnotes": []
    },
    {
      "key": "74:40",
      "surahId": 74,
      "numberInSurah": 40,
      "globalOrder": 5535,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "فِى جَنَّـٰتٍ يَتَسَآءَلُونَ",
      "translationText": "Onlar cennettedirler, sorup dururlar.",
      "translationFootnotes": []
    },
    {
      "key": "74:41",
      "surahId": 74,
      "numberInSurah": 41,
      "globalOrder": 5536,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "عَنِ ٱلْمُجْرِمِينَ",
      "translationText": "Suçluların durumunu.",
      "translationFootnotes": []
    },
    {
      "key": "74:42",
      "surahId": 74,
      "numberInSurah": 42,
      "globalOrder": 5537,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "مَا سَلَكَكُمْ فِى سَقَرَ",
      "translationText": "\"Nedir sizi Sekar'a sokan?\" diye.",
      "translationFootnotes": []
    },
    {
      "key": "74:43",
      "surahId": 74,
      "numberInSurah": 43,
      "globalOrder": 5538,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ",
      "translationText": "Suçlular der ki: \"Biz namaz kılanlardan değildik.\"",
      "translationFootnotes": []
    },
    {
      "key": "74:44",
      "surahId": 74,
      "numberInSurah": 44,
      "globalOrder": 5539,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ",
      "translationText": "\"Yoksula da yedirmezdik.\"",
      "translationFootnotes": []
    },
    {
      "key": "74:45",
      "surahId": 74,
      "numberInSurah": 45,
      "globalOrder": 5540,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ",
      "translationText": "\"Boş şeylere dalanlarla dalar giderdik.\"",
      "translationFootnotes": []
    },
    {
      "key": "74:46",
      "surahId": 74,
      "numberInSurah": 46,
      "globalOrder": 5541,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ",
      "translationText": "\"Ceza gününü yalanlardık.\"",
      "translationFootnotes": []
    },
    {
      "key": "74:47",
      "surahId": 74,
      "numberInSurah": 47,
      "globalOrder": 5542,
      "pageNumber": 576,
      "juzNumber": 29,
      "arabicText": "حَتَّىٰٓ أَتَىٰنَا ٱلْيَقِينُ",
      "translationText": "\"Nihayet bize ölüm gelip çattı.\"",
      "translationFootnotes": []
    },
    {
      "key": "74:48",
      "surahId": 74,
      "numberInSurah": 48,
      "globalOrder": 5543,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "فَمَا تَنفَعُهُمْ شَفَـٰعَةُ ٱلشَّـٰفِعِينَ",
      "translationText": "Artık onlara şefaatçilerin şefaatı fayda vermez.",
      "translationFootnotes": []
    },
    {
      "key": "74:49",
      "surahId": 74,
      "numberInSurah": 49,
      "globalOrder": 5544,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ",
      "translationText": "Şimdi o Kur'ân'dan yüz çevirirlerken ne mazeretleri var?",
      "translationFootnotes": []
    },
    {
      "key": "74:50",
      "surahId": 74,
      "numberInSurah": 50,
      "globalOrder": 5545,
      "pageNumber": 577,
      "juzNumber": 29,
      "arabicText": "كَأَنَّهُمْ حُمُرٌ مُّسْتَنفِرَةٌ",
      "translationText": "Sanki onlar ürkmüş yaban eşekleri.",

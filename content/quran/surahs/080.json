{
  "schemaVersion": 1,
  "surah": {
    "id": 80,
    "nameArabic": "عبس",
    "nameTurkish": "Abese Sûresi",
    "verseCount": 42,
    "firstGlobalOrder": 5759
  },
  "verses": [
    {
      "key": "80:1",
      "surahId": 80,
      "numberInSurah": 1,
      "globalOrder": 5759,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "عَبَسَ وَتَوَلَّىٰٓ",
      "translationText": "(Peygamber) Yüzünü ekşitti ve döndü.",
      "translationFootnotes": []
    },
    {
      "key": "80:2",
      "surahId": 80,
      "numberInSurah": 2,
      "globalOrder": 5760,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
      "translationText": "Kendisine âmâ geldi, diye.",
      "translationFootnotes": []
    },
    {
      "key": "80:3",
      "surahId": 80,
      "numberInSurah": 3,
      "globalOrder": 5761,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
      "translationText": "Ne bilirsin, belki o temizlenecek?",
      "translationFootnotes": []
    },
    {
      "key": "80:4",
      "surahId": 80,
      "numberInSurah": 4,
      "globalOrder": 5762,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
      "translationText": "Veya öğüt belleyecek de öğüt ona fayda verecek.",
      "translationFootnotes": []
    },
    {
      "key": "80:5",
      "surahId": 80,
      "numberInSurah": 5,
      "globalOrder": 5763,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
      "translationText": "Ama buna ihtiyaç hissetmeyene gelince,",
      "translationFootnotes": []
    },
    {
      "key": "80:6",
      "surahId": 80,
      "numberInSurah": 6,
      "globalOrder": 5764,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
      "translationText": "Sen ona yöneliyorsun.",
      "translationFootnotes": []
    },
    {
      "key": "80:7",
      "surahId": 80,
      "numberInSurah": 7,
      "globalOrder": 5765,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
      "translationText": "Onun temizlenmemesinden sana ne?",
      "translationFootnotes": []
    },
    {
      "key": "80:8",
      "surahId": 80,
      "numberInSurah": 8,
      "globalOrder": 5766,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
      "translationText": "Ama sana can atarak gelen,",
      "translationFootnotes": []
    },
    {
      "key": "80:9",
      "surahId": 80,
      "numberInSurah": 9,
      "globalOrder": 5767,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "وَهُوَ يَخْشَىٰ",
      "translationText": "Allah'tan korkarak gelmişken,",
      "translationFootnotes": []
    },
    {
      "key": "80:10",
      "surahId": 80,
      "numberInSurah": 10,
      "globalOrder": 5768,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
      "translationText": "Sen onunla ilgilenmiyorsun.",
      "translationFootnotes": []
    },
    {
      "key": "80:11",
      "surahId": 80,
      "numberInSurah": 11,
      "globalOrder": 5769,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "كَلَّآ إِنَّهَا تَذْكِرَةٌ",
      "translationText": "Hayır hayır, sakın. Çünkü o Kur'ân bir öğüttür.",
      "translationFootnotes": []
    },
    {
      "key": "80:12",
      "surahId": 80,
      "numberInSurah": 12,
      "globalOrder": 5770,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "فَمَن شَآءَ ذَكَرَهُۥ",
      "translationText": "Artık dileyen onu düşünür.",
      "translationFootnotes": []
    },
    {
      "key": "80:13",
      "surahId": 80,
      "numberInSurah": 13,
      "globalOrder": 5771,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "فِى صُحُفٍ مُّكَرَّمَةٍ",
      "translationText": "O, değerli sahifelerdedir.",
      "translationFootnotes": []
    },
    {
      "key": "80:14",
      "surahId": 80,
      "numberInSurah": 14,
      "globalOrder": 5772,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ",
      "translationText": "Yüksek tutulan tertemiz sahifelerde.",
      "translationFootnotes": []
    },
    {
      "key": "80:15",
      "surahId": 80,
      "numberInSurah": 15,
      "globalOrder": 5773,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "بِأَيْدِى سَفَرَةٍ",
      "translationText": "Yazıcıların ellerindedir,",
      "translationFootnotes": []
    },
    {
      "key": "80:16",
      "surahId": 80,
      "numberInSurah": 16,
      "globalOrder": 5774,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "كِرَامٍۭ بَرَرَةٍ",
      "translationText": "Değerli, iyi yazıcıların.",
      "translationFootnotes": []
    },
    {
      "key": "80:17",
      "surahId": 80,
      "numberInSurah": 17,
      "globalOrder": 5775,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ",
      "translationText": "O kahrolası insan, ne nankör şey.",
      "translationFootnotes": []
    },
    {
      "key": "80:18",
      "surahId": 80,
      "numberInSurah": 18,
      "globalOrder": 5776,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
      "translationText": "O yaratan onu hangi şeyden yarattı?",
      "translationFootnotes": []
    },
    {
      "key": "80:19",
      "surahId": 80,
      "numberInSurah": 19,
      "globalOrder": 5777,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
      "translationText": "Bir damla sudan, onu yarattı da biçime koydu.",
      "translationFootnotes": []
    },
    {
      "key": "80:20",
      "surahId": 80,
      "numberInSurah": 20,
      "globalOrder": 5778,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
      "translationText": "Sonra ona yolunu kolaylaştırdı.",
      "translationFootnotes": []
    },
    {
      "key": "80:21",
      "surahId": 80,
      "numberInSurah": 21,
      "globalOrder": 5779,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
      "translationText": "Sonra onu öldürdü de kabre koydurdu.",
      "translationFootnotes": []
    },
    {
      "key": "80:22",
      "surahId": 80,
      "numberInSurah": 22,
      "globalOrder": 5780,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
      "translationText": "Sonra dilediği vakit onu tekrar diriltir.",
      "translationFootnotes": []
    },
    {
      "key": "80:23",
      "surahId": 80,
      "numberInSurah": 23,
      "globalOrder": 5781,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
      "translationText": "Hayır hayır, doğrusu o, hiç Allah'ın emrini tam yerine getirmedi,",
      "translationFootnotes": []
    },
    {
      "key": "80:24",
      "surahId": 80,
      "numberInSurah": 24,
      "globalOrder": 5782,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ",
      "translationText": "Bir de o insan yiyeceğine baksın.",
      "translationFootnotes": []
    },
    {
      "key": "80:25",
      "surahId": 80,
      "numberInSurah": 25,
      "globalOrder": 5783,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا",
      "translationText": "Biz o suyu bol bol döktük.",
      "translationFootnotes": []
    },
    {
      "key": "80:26",
      "surahId": 80,
      "numberInSurah": 26,
      "globalOrder": 5784,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا",
      "translationText": "Sonra toprağı nasıl da yardık.",
      "translationFootnotes": []
    },
    {
      "key": "80:27",
      "surahId": 80,
      "numberInSurah": 27,
      "globalOrder": 5785,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "فَأَنۢبَتْنَا فِيهَا حَبًّا",
      "translationText": "Bu suretle orada ekinler bitirdik.",
      "translationFootnotes": []
    },
    {
      "key": "80:28",
      "surahId": 80,
      "numberInSurah": 28,
      "globalOrder": 5786,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "وَعِنَبًا وَقَضْبًا",
      "translationText": "Üzümler, yoncalar,",
      "translationFootnotes": []
    },
    {
      "key": "80:29",
      "surahId": 80,
      "numberInSurah": 29,
      "globalOrder": 5787,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "وَزَيْتُونًا وَنَخْلًا",
      "translationText": "Zeytinlikler, hurmalıklar,",
      "translationFootnotes": []
    },
    {
      "key": "80:30",
      "surahId": 80,
      "numberInSurah": 30,
      "globalOrder": 5788,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "وَحَدَآئِقَ غُلْبًا",
      "translationText": "İri ve sık ağaçlı bahçeler,",
      "translationFootnotes": []
    },
    {
      "key": "80:31",
      "surahId": 80,
      "numberInSurah": 31,
      "globalOrder": 5789,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "وَفَـٰكِهَةً وَأَبًّا",
      "translationText": "Meyveler, çayırlar bitirdik.",
      "translationFootnotes": []
    },
    {
      "key": "80:32",
      "surahId": 80,
      "numberInSurah": 32,
      "globalOrder": 5790,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
      "translationText": "Siz ve hayvanlarınız faydalansın diye.",
      "translationFootnotes": []
    },
    {
      "key": "80:33",
      "surahId": 80,
      "numberInSurah": 33,
      "globalOrder": 5791,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
      "translationText": "Kulakları sağır eden o gürültü geldiğinde,",
      "translationFootnotes": []
    },
    {
      "key": "80:34",
      "surahId": 80,
      "numberInSurah": 34,
      "globalOrder": 5792,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
      "translationText": "O gün kişi kaçar, kardeşinden...",
      "translationFootnotes": []
    },
    {
      "key": "80:35",
      "surahId": 80,
      "numberInSurah": 35,
      "globalOrder": 5793,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "وَأُمِّهِۦ وَأَبِيهِ",
      "translationText": "Anasından, babasından..",
      "translationFootnotes": []
    },
    {
      "key": "80:36",
      "surahId": 80,
      "numberInSurah": 36,
      "globalOrder": 5794,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "وَصَـٰحِبَتِهِۦ وَبَنِيهِ",
      "translationText": "Eşinden ve oğullarından.",
      "translationFootnotes": []
    },
    {
      "key": "80:37",
      "surahId": 80,
      "numberInSurah": 37,
      "globalOrder": 5795,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ",
      "translationText": "Onlardan her birinin o gün başından aşan işi vardır.",
      "translationFootnotes": []
    },
    {
      "key": "80:38",
      "surahId": 80,
      "numberInSurah": 38,
      "globalOrder": 5796,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ",
      "translationText": "Yüzler var ki, o gün parıl parıl,",
      "translationFootnotes": []
    },
    {
      "key": "80:39",
      "surahId": 80,
      "numberInSurah": 39,
      "globalOrder": 5797,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ",
      "translationText": "Güler, sevinir.",
      "translationFootnotes": []
    },
    {
      "key": "80:40",
      "surahId": 80,
      "numberInSurah": 40,
      "globalOrder": 5798,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ",
      "translationText": "Yüzler de var ki, o gün tozlanmış,",
      "translationFootnotes": []
    },
    {
      "key": "80:41",
      "surahId": 80,
      "numberInSurah": 41,
      "globalOrder": 5799,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "تَرْهَقُهَا قَتَرَةٌ",
      "translationText": "Onları karanlık bürümüş,",
      "translationFootnotes": []
    },
    {
      "key": "80:42",
      "surahId": 80,
      "numberInSurah": 42,
      "globalOrder": 5800,
      "pageNumber": 585,
      "juzNumber": 30,
      "arabicText": "أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",
      "translationText": "İşte onlardır kâfirler, haktan sapanlar.",
      "translationFootnotes": []
    }
  ]
}

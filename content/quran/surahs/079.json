{
  "schemaVersion": 1,
  "surah": {
    "id": 79,
    "nameArabic": "النازعات",
    "nameTurkish": null,
    "verseCount": 46,
    "firstGlobalOrder": 5713
  },
  "verses": [
    {
      "key": "79:1",
      "surahId": 79,
      "numberInSurah": 1,
      "globalOrder": 5713,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "وَٱلنَّـٰزِعَـٰتِ غَرْقًا",
      "translationText": "Andolsun şiddetle çekip çıkaranlara,",
      "translationFootnotes": []
    },
    {
      "key": "79:2",
      "surahId": 79,
      "numberInSurah": 2,
      "globalOrder": 5714,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "وَٱلنَّـٰشِطَـٰتِ نَشْطًا",
      "translationText": "Usulcacık çekenlere,",
      "translationFootnotes": []
    },
    {
      "key": "79:3",
      "surahId": 79,
      "numberInSurah": 3,
      "globalOrder": 5715,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "وَٱلسَّـٰبِحَـٰتِ سَبْحًا",
      "translationText": "Yüzüp yüzüp gidenlere,",
      "translationFootnotes": []
    },
    {
      "key": "79:4",
      "surahId": 79,
      "numberInSurah": 4,
      "globalOrder": 5716,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "فَٱلسَّـٰبِقَـٰتِ سَبْقًا",
      "translationText": "Yarışıp geçenlere,",
      "translationFootnotes": []
    },
    {
      "key": "79:5",
      "surahId": 79,
      "numberInSurah": 5,
      "globalOrder": 5717,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "فَٱلْمُدَبِّرَٰتِ أَمْرًا",
      "translationText": "Derken bir iş çevirenlere kasem olsun (ki kıyamet var).",
      "translationFootnotes": []
    },
    {
      "key": "79:6",
      "surahId": 79,
      "numberInSurah": 6,
      "globalOrder": 5718,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
      "translationText": "O gün deprem sarsar,",
      "translationFootnotes": []
    },
    {
      "key": "79:7",
      "surahId": 79,
      "numberInSurah": 7,
      "globalOrder": 5719,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "تَتْبَعُهَا ٱلرَّادِفَةُ",
      "translationText": "Onu ikinci bir sarsıntı izler.",
      "translationFootnotes": []
    },
    {
      "key": "79:8",
      "surahId": 79,
      "numberInSurah": 8,
      "globalOrder": 5720,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ",
      "translationText": "Yürekler vardır, o gün kaygıdan hoplar.",
      "translationFootnotes": []
    },
    {
      "key": "79:9",
      "surahId": 79,
      "numberInSurah": 9,
      "globalOrder": 5721,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "أَبْصَـٰرُهَا خَـٰشِعَةٌ",
      "translationText": "Gözler kalkmaz saygıdan.",
      "translationFootnotes": []
    },
    {
      "key": "79:10",
      "surahId": 79,
      "numberInSurah": 10,
      "globalOrder": 5722,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
      "translationText": "Diyorlar ki: \"Biz tekrar eski halimize mi döndürülecekmişiz?",
      "translationFootnotes": []
    },
    {
      "key": "79:11",
      "surahId": 79,
      "numberInSurah": 11,
      "globalOrder": 5723,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً",
      "translationText": "\"Biz, çürümüş kemikler olduktan sonra ha?\"",
      "translationFootnotes": []
    },
    {
      "key": "79:12",
      "surahId": 79,
      "numberInSurah": 12,
      "globalOrder": 5724,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
      "translationText": "\"Öyleyse bu çok zararlı bir dönüştür.\" dediler.",
      "translationFootnotes": []
    },
    {
      "key": "79:13",
      "surahId": 79,
      "numberInSurah": 13,
      "globalOrder": 5725,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ",
      "translationText": "Fakat o bir tek haykırıştır.",
      "translationFootnotes": []
    },
    {
      "key": "79:14",
      "surahId": 79,
      "numberInSurah": 14,
      "globalOrder": 5726,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
      "translationText": "Bir de bakarsın hepsi meydandadır.",
      "translationFootnotes": []
    },
    {
      "key": "79:15",
      "surahId": 79,
      "numberInSurah": 15,
      "globalOrder": 5727,
      "pageNumber": 583,
      "juzNumber": 30,
      "arabicText": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
      "translationText": "Musa'nın haberi sana geldi mi?",
      "translationFootnotes": []
    },
    {
      "key": "79:16",
      "surahId": 79,
      "numberInSurah": 16,
      "globalOrder": 5728,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
      "translationText": "Hani Rabbi ona kutsal vaadi Tuva'da seslenmişti:",
      "translationFootnotes": []
    },
    {
      "key": "79:17",
      "surahId": 79,
      "numberInSurah": 17,
      "globalOrder": 5729,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
      "translationText": "\"Haydi, demişti, git Firavun'a, çünkü o çok azdı.\"",
      "translationFootnotes": []
    },
    {
      "key": "79:18",
      "surahId": 79,
      "numberInSurah": 18,
      "globalOrder": 5730,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
      "translationText": "De ki: İster misin arınasın?",
      "translationFootnotes": []
    },
    {
      "key": "79:19",
      "surahId": 79,
      "numberInSurah": 19,
      "globalOrder": 5731,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
      "translationText": "Seni Rabbinin yoluna ileteyim de ondan korkasın.",
      "translationFootnotes": []
    },
    {
      "key": "79:20",
      "surahId": 79,
      "numberInSurah": 20,
      "globalOrder": 5732,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ",
      "translationText": "Musa Firavun'a o büyük mucizeyi gösterdi.",
      "translationFootnotes": []
    },
    {
      "key": "79:21",
      "surahId": 79,
      "numberInSurah": 21,
      "globalOrder": 5733,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "فَكَذَّبَ وَعَصَىٰ",
      "translationText": "Fakat Firavun yalanladı, karşı geldi.",
      "translationFootnotes": []
    },
    {
      "key": "79:22",
      "surahId": 79,
      "numberInSurah": 22,
      "globalOrder": 5734,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
      "translationText": "Sonra koşarak dönüp gitti.",
      "translationFootnotes": []
    },
    {
      "key": "79:23",
      "surahId": 79,
      "numberInSurah": 23,
      "globalOrder": 5735,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "فَحَشَرَ فَنَادَىٰ",
      "translationText": "Derken adamlarını topladı da bağırdı:",
      "translationFootnotes": []
    },
    {
      "key": "79:24",
      "surahId": 79,
      "numberInSurah": 24,
      "globalOrder": 5736,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
      "translationText": "\"Ben sizin en yüce Rabbinizim\" dedi.",
      "translationFootnotes": []
    },
    {
      "key": "79:25",
      "surahId": 79,
      "numberInSurah": 25,
      "globalOrder": 5737,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ",
      "translationText": "Allah da onu tuttu, dünya ve ahiret azabıyla yakalayıverdi.",
      "translationFootnotes": []
    },
    {
      "key": "79:26",
      "surahId": 79,
      "numberInSurah": 26,
      "globalOrder": 5738,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ",
      "translationText": "Kuşkusuz bunda, saygı duyacaklar için bir ibret vardır.",
      "translationFootnotes": []
    },
    {
      "key": "79:27",
      "surahId": 79,
      "numberInSurah": 27,
      "globalOrder": 5739,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
      "translationText": "Yaratılışça siz mi daha çetinsiniz, yoksa gök mü? Onu Allah bina etti.",
      "translationFootnotes": []
    },
    {
      "key": "79:28",
      "surahId": 79,
      "numberInSurah": 28,
      "globalOrder": 5740,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
      "translationText": "Tavanını yükseltti, onu bir düzene koydu.",
      "translationFootnotes": []
    },
    {
      "key": "79:29",
      "surahId": 79,
      "numberInSurah": 29,
      "globalOrder": 5741,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
      "translationText": "Gecesini kararttı, kuşluğunu çıkardı.",
      "translationFootnotes": []
    },
    {
      "key": "79:30",
      "surahId": 79,
      "numberInSurah": 30,
      "globalOrder": 5742,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
      "translationText": "Bundan sonra da yeryüzünü döşedi.",
      "translationFootnotes": []
    },
    {
      "key": "79:31",
      "surahId": 79,
      "numberInSurah": 31,
      "globalOrder": 5743,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",
      "translationText": "Ondan suyunu ve otlağını çıkardı.",
      "translationFootnotes": []
    },
    {
      "key": "79:32",
      "surahId": 79,
      "numberInSurah": 32,
      "globalOrder": 5744,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "وَٱلْجِبَالَ أَرْسَىٰهَا",
      "translationText": "Dağlarını oturttu.",
      "translationFootnotes": []
    },
    {
      "key": "79:33",
      "surahId": 79,
      "numberInSurah": 33,
      "globalOrder": 5745,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
      "translationText": "Sizin ve hayvanlarınızın geçimi için.",
      "translationFootnotes": []
    },
    {
      "key": "79:34",
      "surahId": 79,
      "numberInSurah": 34,
      "globalOrder": 5746,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ",
      "translationText": "Fakat o her şeyi bastıran büyük felaket geldiği vakit,",
      "translationFootnotes": []
    },
    {
      "key": "79:35",
      "surahId": 79,
      "numberInSurah": 35,
      "globalOrder": 5747,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ",
      "translationText": "O, insanın neyin peşinde koştuğunu anladığı gün,",
      "translationFootnotes": []
    },
    {
      "key": "79:36",
      "surahId": 79,
      "numberInSurah": 36,
      "globalOrder": 5748,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ",
      "translationText": "Gören kimseler için cehennem hortlatıldığı vakit,",
      "translationFootnotes": []
    },
    {
      "key": "79:37",
      "surahId": 79,
      "numberInSurah": 37,
      "globalOrder": 5749,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "فَأَمَّا مَن طَغَىٰ",
      "translationText": "Artık her kim azgınlık etmiş,",
      "translationFootnotes": []
    },
    {
      "key": "79:38",
      "surahId": 79,
      "numberInSurah": 38,
      "globalOrder": 5750,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "translationText": "Ve dünya hayatını tercih etmişse,",
      "translationFootnotes": []
    },
    {
      "key": "79:39",
      "surahId": 79,
      "numberInSurah": 39,
      "globalOrder": 5751,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ",
      "translationText": "Kuşkusuz onun varacağı yer cehennemdir.",
      "translationFootnotes": []
    },
    {
      "key": "79:40",
      "surahId": 79,
      "numberInSurah": 40,
      "globalOrder": 5752,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",
      "translationText": "Kim de Rabbinin divanında durmaktan korkmuş, nefsini boş heveslerden menetmiş ise,",
      "translationFootnotes": []
    },
    {
      "key": "79:41",
      "surahId": 79,
      "numberInSurah": 41,
      "globalOrder": 5753,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ",
      "translationText": "Kuşkusuz onun varacağı yer cennettir.",
      "translationFootnotes": []
    },
    {
      "key": "79:42",
      "surahId": 79,
      "numberInSurah": 42,
      "globalOrder": 5754,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا",
      "translationText": "Sana o kıyameti soruyorlar, ne zaman kopacak diye.",
      "translationFootnotes": []
    },
    {
      "key": "79:43",
      "surahId": 79,
      "numberInSurah": 43,
      "globalOrder": 5755,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ",
      "translationText": "Sen nerde, onu anlatmak nerde?!",
      "translationFootnotes": []
    },
    {
      "key": "79:44",
      "surahId": 79,
      "numberInSurah": 44,
      "globalOrder": 5756,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ",
      "translationText": "Onun son ilmi Rabbine aittir.",
      "translationFootnotes": []
    },
    {
      "key": "79:45",
      "surahId": 79,
      "numberInSurah": 45,
      "globalOrder": 5757,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا",
      "translationText": "Sen ancak ondan korkacak olanları uyarıcısın.",
      "translationFootnotes": []
    },
    {
      "key": "79:46",
      "surahId": 79,
      "numberInSurah": 46,
      "globalOrder": 5758,
      "pageNumber": 584,
      "juzNumber": 30,
      "arabicText": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا",
      "translationText": "Onlar o kıyameti görecekleri gün sanki dünyada bir akşam veya kuşluğundan başka durmamışa dönecekler.",
      "translationFootnotes": []
    }
  ]
}

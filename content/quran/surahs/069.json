      "surahId": 69,
      "numberInSurah": 51,
      "globalOrder": 5374,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ",
      "translationText": "Gerçekten o, şüphe götürmez bir bilgidir.",

{
  "schemaVersion": 1,
  "surah": {
    "id": 69,
    "nameArabic": "الحاقة",
    "nameTurkish": "Hâkka Sûresi",
    "verseCount": 52,
    "firstGlobalOrder": 5324
  },
  "verses": [
    {
      "key": "69:1",
      "surahId": 69,
      "numberInSurah": 1,
      "globalOrder": 5324,
      "pageNumber": 566,
      "juzNumber": 29,
      "arabicText": "ٱلْحَآقَّةُ",
      "translationText": "(Gerçekleşecek) Kıyamet!",
      "translationFootnotes": []
    },
    {
      "key": "69:2",
      "surahId": 69,
      "numberInSurah": 2,
      "globalOrder": 5325,
      "pageNumber": 566,
      "juzNumber": 29,
      "arabicText": "مَا ٱلْحَآقَّةُ",
      "translationText": "Nedir, o Kıyamet?",
      "translationFootnotes": []
    },
    {
      "key": "69:3",
      "surahId": 69,
      "numberInSurah": 3,
      "globalOrder": 5326,
      "pageNumber": 566,
      "juzNumber": 29,
      "arabicText": "وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ",
      "translationText": "Gerçekleşenin (Kıaymetin) ne olduğunu sen nerden bileceksin?",
      "translationFootnotes": []
    },
    {
      "key": "69:4",
      "surahId": 69,
      "numberInSurah": 4,
      "globalOrder": 5327,
      "pageNumber": 566,
      "juzNumber": 29,
      "arabicText": "كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ",
      "translationText": "Semûd ve Âd, kapılarını çalacak olan o felaketi yalan saymışlardı.",
      "translationFootnotes": []
    },
    {
      "key": "69:5",
      "surahId": 69,
      "numberInSurah": 5,
      "globalOrder": 5328,
      "pageNumber": 566,
      "juzNumber": 29,
      "arabicText": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ",
      "translationText": "Semûd kavmi korkunç bir sesle yok edildi.",
      "translationFootnotes": []
    },
    {
      "key": "69:6",
      "surahId": 69,
      "numberInSurah": 6,
      "globalOrder": 5329,
      "pageNumber": 566,
      "juzNumber": 29,
      "arabicText": "وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ",
      "translationText": "Âd kavmi ise gürültülü ve azgın bir fırtına ile yok edildiler.",
      "translationFootnotes": []
    },
    {
      "key": "69:7",
      "surahId": 69,
      "numberInSurah": 7,
      "globalOrder": 5330,
      "pageNumber": 566,
      "juzNumber": 29,
      "arabicText": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَـٰنِيَةَ أَيَّامٍ حُسُومًا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ",
      "translationText": "Allah o fırtınayı üzerlerine yedi gece sekiz gündüz musallat etmişti. Öyle ki, o kavmi içi boş hurma kütükleri gibi oracıkta yere serilmiş halde görürdün.",
      "translationFootnotes": []
    },
    {
      "key": "69:8",
      "surahId": 69,
      "numberInSurah": 8,
      "globalOrder": 5331,
      "pageNumber": 566,
      "juzNumber": 29,
      "arabicText": "فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ",
      "translationText": "Bak şimdi görebilir misin onlardan bir kalıntı?",
      "translationFootnotes": []
    },
    {
      "key": "69:9",
      "surahId": 69,
      "numberInSurah": 9,
      "globalOrder": 5332,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَـٰتُ بِٱلْخَاطِئَةِ",
      "translationText": "Firavun, ondan öncekiler ve altı üstüne getirilen beldeler de hep o hatayı işleyegeldiler.",
      "translationFootnotes": []
    },
    {
      "key": "69:10",
      "surahId": 69,
      "numberInSurah": 10,
      "globalOrder": 5333,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَّابِيَةً",
      "translationText": "Hep Rablerinin elçilerine karşı geldiler. O da onları pek şiddetli bir şekilde yakalayıverdi.",
      "translationFootnotes": []
    },
    {
      "key": "69:11",
      "surahId": 69,
      "numberInSurah": 11,
      "globalOrder": 5334,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَـٰكُمْ فِى ٱلْجَارِيَةِ",
      "translationText": "Kuşkusuz, sular kabarınca sizi gemide biz taşıdık.",
      "translationFootnotes": []
    },
    {
      "key": "69:12",
      "surahId": 69,
      "numberInSurah": 12,
      "globalOrder": 5335,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَآ أُذُنٌ وَٰعِيَةٌ",
      "translationText": "Onu size bir ibret yapalım ve belleyici kulaklar bellesin diye.",
      "translationFootnotes": []
    },
    {
      "key": "69:13",
      "surahId": 69,
      "numberInSurah": 13,
      "globalOrder": 5336,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌ وَٰحِدَةٌ",
      "translationText": "Sûr'a bir tek üfleme üflendiği,",
      "translationFootnotes": []
    },
    {
      "key": "69:14",
      "surahId": 69,
      "numberInSurah": 14,
      "globalOrder": 5337,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةً وَٰحِدَةً",
      "translationText": "Arz ve dağlar yerlerinden kaldırılıp şiddetle birbirine çarpılarak darmadağın olduğu zaman,",
      "translationFootnotes": []
    },
    {
      "key": "69:15",
      "surahId": 69,
      "numberInSurah": 15,
      "globalOrder": 5338,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "فَيَوْمَئِذٍ وَقَعَتِ ٱلْوَاقِعَةُ",
      "translationText": "İşte o gün olacak olur.",
      "translationFootnotes": []
    },
    {
      "key": "69:16",
      "surahId": 69,
      "numberInSurah": 16,
      "globalOrder": 5339,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍ وَاهِيَةٌ",
      "translationText": "O gün gök yarılmış, sarkmıştır.",
      "translationFootnotes": []
    },
    {
      "key": "69:17",
      "surahId": 69,
      "numberInSurah": 17,
      "globalOrder": 5340,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَـٰنِيَةٌ",
      "translationText": "Melekler de onun etrafındadır, O gün Rabbinin Arşını bunların da üstünde sekiz melek yüklenir.",
      "translationFootnotes": []
    },
    {
      "key": "69:18",
      "surahId": 69,
      "numberInSurah": 18,
      "globalOrder": 5341,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌ",
      "translationText": "O gün (hesap için Allah'a) arz olunursunuz, öyle ki gizli bir haliniz kalmaz.",
      "translationFootnotes": []
    },
    {
      "key": "69:19",
      "surahId": 69,
      "numberInSurah": 19,
      "globalOrder": 5342,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَـٰبِيَهْ",
      "translationText": "Kitabı sağından verilen, \"alın okuyun kitabımı..\"",
      "translationFootnotes": []
    },
    {
      "key": "69:20",
      "surahId": 69,
      "numberInSurah": 20,
      "globalOrder": 5343,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "إِنِّى ظَنَنتُ أَنِّى مُلَـٰقٍ حِسَابِيَهْ",
      "translationText": "\"Çünkü ben hesabıma kavuşacağımı sezmiştim\" der.",
      "translationFootnotes": []
    },
    {
      "key": "69:21",
      "surahId": 69,
      "numberInSurah": 21,
      "globalOrder": 5344,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ",
      "translationText": "Artık o hoşnut bir hayattadır.",
      "translationFootnotes": []
    },
    {
      "key": "69:22",
      "surahId": 69,
      "numberInSurah": 22,
      "globalOrder": 5345,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "فِى جَنَّةٍ عَالِيَةٍ",
      "translationText": "Yüksek bir cennettedir.",
      "translationFootnotes": []
    },
    {
      "key": "69:23",
      "surahId": 69,
      "numberInSurah": 23,
      "globalOrder": 5346,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "قُطُوفُهَا دَانِيَةٌ",
      "translationText": "Ki o cennetin meyveleri sarkmıştır.",
      "translationFootnotes": []
    },
    {
      "key": "69:24",
      "surahId": 69,
      "numberInSurah": 24,
      "globalOrder": 5347,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ",
      "translationText": "\"Geçmiş günlerde yaptığınız işlerden ötürü afiyetle yeyin, için.\" (denir).",
      "translationFootnotes": []
    },
    {
      "key": "69:25",
      "surahId": 69,
      "numberInSurah": 25,
      "globalOrder": 5348,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَـٰلَيْتَنِى لَمْ أُوتَ كِتَـٰبِيَهْ",
      "translationText": "Kitabı sol tarafından verilen ise der ki: \"Keşke kitabım verilmeseydi de,",
      "translationFootnotes": []
    },
    {
      "key": "69:26",
      "surahId": 69,
      "numberInSurah": 26,
      "globalOrder": 5349,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "وَلَمْ أَدْرِ مَا حِسَابِيَهْ",
      "translationText": "Hesabımın ne olduğunu bilmeseydim,",
      "translationFootnotes": []
    },
    {
      "key": "69:27",
      "surahId": 69,
      "numberInSurah": 27,
      "globalOrder": 5350,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "يَـٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ",
      "translationText": "Ne olurdu o ölüm, iş bitirici olsaydı.",
      "translationFootnotes": []
    },
    {
      "key": "69:28",
      "surahId": 69,
      "numberInSurah": 28,
      "globalOrder": 5351,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ",
      "translationText": "Malım bana hiç fayda vermedi.",
      "translationFootnotes": []
    },
    {
      "key": "69:29",
      "surahId": 69,
      "numberInSurah": 29,
      "globalOrder": 5352,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "هَلَكَ عَنِّى سُلْطَـٰنِيَهْ",
      "translationText": "Gücüm de benden yok olup gitti.\"",
      "translationFootnotes": []
    },
    {
      "key": "69:30",
      "surahId": 69,
      "numberInSurah": 30,
      "globalOrder": 5353,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "خُذُوهُ فَغُلُّوهُ",
      "translationText": "(Zebanilere şöyle denir): \"Onu yakalayın da bağlayın.\"",
      "translationFootnotes": []
    },
    {
      "key": "69:31",
      "surahId": 69,
      "numberInSurah": 31,
      "globalOrder": 5354,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "ثُمَّ ٱلْجَحِيمَ صَلُّوهُ",
      "translationText": "\"Sonra cehenneme atın onu.\"",
      "translationFootnotes": []
    },
    {
      "key": "69:32",
      "surahId": 69,
      "numberInSurah": 32,
      "globalOrder": 5355,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "ثُمَّ فِى سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَٱسْلُكُوهُ",
      "translationText": "\"Sonra da boyu yetmiş arşın zincir içerisinde onu oraya sokun.\"",
      "translationFootnotes": []
    },
    {
      "key": "69:33",
      "surahId": 69,
      "numberInSurah": 33,
      "globalOrder": 5356,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ",
      "translationText": "Çünkü o, büyük Allah'a inanmıyordu.",
      "translationFootnotes": []
    },
    {
      "key": "69:34",
      "surahId": 69,
      "numberInSurah": 34,
      "globalOrder": 5357,
      "pageNumber": 567,
      "juzNumber": 29,
      "arabicText": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "translationText": "Yoksula yedirmeye teşvik etmiyordu.",
      "translationFootnotes": []
    },
    {
      "key": "69:35",
      "surahId": 69,
      "numberInSurah": 35,
      "globalOrder": 5358,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "فَلَيْسَ لَهُ ٱلْيَوْمَ هَـٰهُنَا حَمِيمٌ",
      "translationText": "Bu sebeple bugün burada onun candan bir dostu yoktur.",
      "translationFootnotes": []
    },
    {
      "key": "69:36",
      "surahId": 69,
      "numberInSurah": 36,
      "globalOrder": 5359,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ",
      "translationText": "Bir irinden başka yiyecek de yok.",
      "translationFootnotes": []
    },
    {
      "key": "69:37",
      "surahId": 69,
      "numberInSurah": 37,
      "globalOrder": 5360,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَـٰطِـُٔونَ",
      "translationText": "Onu günahkârlardan başkası yemez.",
      "translationFootnotes": []
    },
    {
      "key": "69:38",
      "surahId": 69,
      "numberInSurah": 38,
      "globalOrder": 5361,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ",
      "translationText": "Andolsun gördüklerinize,",
      "translationFootnotes": []
    },
    {
      "key": "69:39",
      "surahId": 69,
      "numberInSurah": 39,
      "globalOrder": 5362,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "وَمَا لَا تُبْصِرُونَ",
      "translationText": "Ve görmediklerinize..",
      "translationFootnotes": []
    },
    {
      "key": "69:40",
      "surahId": 69,
      "numberInSurah": 40,
      "globalOrder": 5363,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
      "translationText": "Kuşkusuz Kur'ân, şerefli bir peygamberin (Allah'tan) getirdiği sözdür.",
      "translationFootnotes": []
    },
    {
      "key": "69:41",
      "surahId": 69,
      "numberInSurah": 41,
      "globalOrder": 5364,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "وَمَا هُوَ بِقَوْلِ شَاعِرٍ ۚ قَلِيلًا مَّا تُؤْمِنُونَ",
      "translationText": "O bir şair sözü değildir, siz çok az inanıyorsunuz.",
      "translationFootnotes": []
    },
    {
      "key": "69:42",
      "surahId": 69,
      "numberInSurah": 42,
      "globalOrder": 5365,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَّا تَذَكَّرُونَ",
      "translationText": "Bir kâhin sözü de değildir, ne de az düşünüyorsunuz!",
      "translationFootnotes": []
    },
    {
      "key": "69:43",
      "surahId": 69,
      "numberInSurah": 43,
      "globalOrder": 5366,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ",
      "translationText": "O, âlemlerin Rabbi tarafından indirilmedir.",
      "translationFootnotes": []
    },
    {
      "key": "69:44",
      "surahId": 69,
      "numberInSurah": 44,
      "globalOrder": 5367,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ",
      "translationText": "O, bize isnâden bazı sözler uydurmaya kalkışsaydı,",
      "translationFootnotes": []
    },
    {
      "key": "69:45",
      "surahId": 69,
      "numberInSurah": 45,
      "globalOrder": 5368,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ",
      "translationText": "Elbette biz onu bundan dolayı kuvvetle yakalardık.",
      "translationFootnotes": []
    },
    {
      "key": "69:46",
      "surahId": 69,
      "numberInSurah": 46,
      "globalOrder": 5369,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ",
      "translationText": "Sonra da onun şah damarını keser atardık.",
      "translationFootnotes": []
    },
    {
      "key": "69:47",
      "surahId": 69,
      "numberInSurah": 47,
      "globalOrder": 5370,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَـٰجِزِينَ",
      "translationText": "O vakit sizden hiçbiriniz ona siper de olamazdınız.",

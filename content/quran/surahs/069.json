      "surahId": 69,
      "numberInSurah": 49,
      "globalOrder": 5372,
      "pageNumber": 568,
      "juzNumber": 29,
      "arabicText": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ",
      "translationText": "Bununla beraber biz biliyoruz ki sizden inanmayanlar var.",
      "translationFootnotes": []
    },
